---
import "../styles/Visual-Gallery.css";

// Gallery tiles. Each tile shows its poster image and plays its video on hover (or when on screen on phones).
// To add your own work: drop the video in public/videos, a still frame in public/images/gallery, and add a row here.
const items = [
  { title: "Timber house at dusk", tag: "Exterior visualization", video: "/videos/exterior-1.mp4", poster: "/images/gallery/exterior-1.jpg", size: "xl" },
  { title: "Lounge interior", tag: "Interior visualization", video: "/videos/interior-1.mp4", poster: "/images/gallery/interior-1.jpg", size: "md" },
  { title: "Open-plan walkthrough", tag: "Animation", video: "/videos/video2.mp4", poster: "/images/gallery/video2.jpg", size: "md" },
  { title: "Rooftop pool", tag: "Exterior visualization", video: "/videos/video3.mp4", poster: "/images/gallery/video3.jpg", size: "wide" },
  { title: "Courtyard landscape", tag: "Landscape & site", video: "/videos/landscape.mp4", poster: "/images/gallery/landscape.jpg", size: "wide", letterbox: true },
];
---

<section class="vg" id="visual-gallery" aria-labelledby="vg-title">
  <div class="vg-wrap">
    <header class="vg-head">
      <div>
        <span class="vg-eyebrow">Portfolio</span>
        <h2 class="vg-title" id="vg-title">Walk the <em>gallery.</em></h2>
      </div>
      <p class="vg-intro">Selected stills and films. Hover a piece to play it, or open the full portfolio.</p>
    </header>

    <div class="vg-grid">
      {items.map((it, i) => (
        <a href="/visuals/#case-studies" class:list={["vg-tile", `vg-tile--${it.size}`, it.letterbox && "is-letterbox"]} style={`--i:${i}`}>
          <img class="vg-poster" src={it.poster} alt={`${it.title}: ${it.tag}`} loading="lazy" decoding="async" />
          <video class="vg-video" muted loop playsinline preload="none" poster={it.poster} data-src={it.video} aria-hidden="true"></video>
          <span class="vg-shade" aria-hidden="true"></span>
          <span class="vg-meta">
            <span class="vg-tag">{it.tag}</span>
            <span class="vg-name">{it.title}</span>
          </span>
          <span class="vg-play" aria-hidden="true">
            <svg viewBox="0 0 16 16"><path d="M5 3.5v9l7-4.5z" /></svg>
          </span>
        </a>
      ))}
    </div>

    <div class="vg-foot">
      <a href="/visuals/" class="vg-cta">
        <span>View full portfolio</span>
        <span class="vg-cta-arrow" aria-hidden="true">
          <svg viewBox="0 0 16 16"><path d="M3 8h10M9 4l4 4-4 4" /></svg>
        </span>
      </a>
    </div>
  </div>
</section>

<script>
  // Videos load only when first needed. Desktop: play on hover. Touch screens: play while on screen.
  const tiles = Array.from(document.querySelectorAll<HTMLElement>(".vg-tile"));
  const reduce = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
  const canHover = window.matchMedia("(hover: hover)").matches;

  function play(tile: HTMLElement) {
    const v = tile.querySelector<HTMLVideoElement>(".vg-video");
    if (!v || reduce) return;
    if (!v.src && v.dataset.src) v.src = v.dataset.src;
    v.play().then(() => tile.classList.add("is-playing")).catch(() => {});
  }
  function stop(tile: HTMLElement) {
    const v = tile.querySelector<HTMLVideoElement>(".vg-video");
    if (!v) return;
    v.pause();
    tile.classList.remove("is-playing");
  }

  if (canHover) {
    tiles.forEach((t) => {
      t.addEventListener("mouseenter", () => play(t));
      t.addEventListener("mouseleave", () => stop(t));
      t.addEventListener("focus", () => play(t));
      t.addEventListener("blur", () => stop(t));
    });
  } else {
    const io = new IntersectionObserver(
      (entries) => entries.forEach((e) => (e.isIntersecting ? play(e.target as HTMLElement) : stop(e.target as HTMLElement))),
      { threshold: 0.6 }
    );
    tiles.forEach((t) => io.observe(t));
  }
</script>
