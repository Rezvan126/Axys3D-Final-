---
import Logo from "./Logo.astro";
import { social } from "../data/social";
import { services } from "../data/services";
const socials = social.filter((s) => s.url);
---

<footer class="ax-foot ax-dark">
  <div class="ax-wrap">
    <div class="ax-foot-top">
      <div class="ax-foot-brand">
        <a href="/" class="ax-foot-logo" aria-label="Axys3D home"><Logo /></a>
        <p>BIM, Revit and visualization production for architects, engineers, developers and agencies.</p>
        <a href="mailto:info@axys3d.com" class="ax-foot-mail">info@axys3d.com</a>
      </div>

      <nav class="ax-foot-col" aria-label="Services">
        <span class="ax-foot-h">Services</span>
        {services.map((s) => <a href={`/services/${s.slug}/`}>{s.title}</a>)}
      </nav>

      <nav class="ax-foot-col" aria-label="Company">
        <span class="ax-foot-h">Company</span>
        <a href="/visuals/">Work</a>
        <a href="/tours/">Virtual tours</a>
        <a href="/industries/">Industries</a>
        <a href="/insights/">Insights</a>
        <a href="/about/">About</a>
        <a href="/hire/">Hire us</a>
        <a href="/contact/">Contact</a>
      </nav>

      {socials.length > 0 && (
        <nav class="ax-foot-col" aria-label="Social">
          <span class="ax-foot-h">Follow</span>
          {socials.map((s) => <a href={s.url} target="_blank" rel="noopener noreferrer">{s.name}</a>)}
        </nav>
      )}
    </div>

    <div class="ax-foot-bottom">
      <p>© {new Date().getFullYear()} Axys3D. Production support only. Design authority and professional sign off stay with your appointed professionals.</p>
    </div>
  </div>
</footer>

<style is:global>
  .ax-foot { padding: clamp(56px, 7vw, 96px) 0 32px; font-family: var(--ax-font); color: var(--ax-text-2); }
  .ax-foot-top { display: grid; grid-template-columns: 1.6fr 1.3fr 1fr auto; gap: 48px; padding-bottom: 48px; }
  .ax-foot-brand { display: flex; flex-direction: column; align-items: flex-start; gap: 16px; max-width: 360px; }
  .ax-foot-logo { display: inline-flex; align-items: center; min-height: 44px; color: var(--ax-text); }
  .ax-foot-logo .ax-logo { height: 30px; }
  .ax-foot-brand p { margin: 0; font-size: 15.5px; line-height: 1.55; }
  .ax-foot-mail { display: inline-flex; align-items: center; min-height: 44px; color: var(--ax-text); font-size: 16px; font-weight: 600; text-decoration: underline; text-decoration-color: var(--ax-accent); text-underline-offset: 5px; }
  .ax-foot-col { display: flex; flex-direction: column; min-width: 0; }
  .ax-foot-h { margin-bottom: 12px; font: 600 13.5px/1.3 var(--ax-font); text-transform: uppercase; color: var(--ax-text-3); }
  .ax-foot-col a { display: inline-flex; align-items: center; min-height: 44px; font-size: 15px; color: var(--ax-text-2); text-decoration: none; transition: color 0.2s ease; }
  .ax-foot-col a:hover { color: var(--ax-text); }
  .ax-foot-bottom { padding-top: 24px; border-top: 1px solid var(--ax-line); }
  .ax-foot-bottom p { margin: 0; font-size: 13px; line-height: 1.5; color: var(--ax-text-3); max-width: 60em; }
  @media (max-width: 900px) { .ax-foot-top { grid-template-columns: 1fr 1fr; gap: 36px 24px; } .ax-foot-brand { grid-column: 1 / -1; } }
  /* phones: a short footer. The eight services are one tap away in the menu, so the list is left out here. */
  @media (max-width: 600px) {
    .ax-foot { padding: 40px 0 24px; }
    .ax-foot-top { grid-template-columns: 1fr; gap: 20px; padding-bottom: 20px; }
    .ax-foot-brand { gap: 6px; }
    .ax-foot-col[aria-label="Services"] { display: none; }
    .ax-foot-col[aria-label="Company"] { display: grid; grid-template-columns: 1fr 1fr; column-gap: 24px; }
    .ax-foot-col[aria-label="Company"] .ax-foot-h { grid-column: 1 / -1; margin-bottom: 4px; }
    .ax-foot-bottom { padding-top: 16px; }
  }
</style>
