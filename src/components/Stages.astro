---
import "../styles/stages.css";

// SKETCH IN. RENDER OUT. Pure visuals, driven by the scroll.
// The section pins while you scroll. The image starts lined up with the other sections,
// expands to fill the screen, then the same building moves from sketch to massing,
// BIM model and final render (each stage sweeps in from the left). No labels on the image.
// Images: public/images/stages/stage-1..4.jpg (same building, each stage).
const stages = [
  { title: "Sketch", img: "/images/stages/stage-1.jpg" },
  { title: "Massing", img: "/images/stages/stage-2.jpg" },
  { title: "BIM model", img: "/images/stages/stage-3.jpg" },
  { title: "Final render", img: "/images/stages/stage-4.jpg" },
];
---

<section class="sg" id="stages" aria-labelledby="sg-title">
  <div class="sg-pin">
    <div class="sg-head">
      <div class="sg-head-in">
        <h2 class="sg-title" id="sg-title">Sketch in. <span>Render out.</span></h2>
      </div>
    </div>

    <figure class="sg-frame" aria-label="The same building as a sketch, a massing model, a BIM model and a final render">
      <div class="sg-zoom">
        {stages.map((s, i) => (
          <img class="sg-layer" src={s.img} alt={`${s.title} stage of the building`} loading={i < 2 ? "eager" : "lazy"} decoding="async" />
        ))}
      </div>
      <span class="sg-scan" aria-hidden="true"></span>
    </figure>
  </div>
</section>

<script>
  const root = document.getElementById("stages") as HTMLElement | null;
  if (root) {
    const pin = root.querySelector<HTMLElement>(".sg-pin")!;
    const head = root.querySelector<HTMLElement>(".sg-head")!;
    const frame = root.querySelector<HTMLElement>(".sg-frame")!;
    const zoom = root.querySelector<HTMLElement>(".sg-zoom")!;
    const scan = root.querySelector<HTMLElement>(".sg-scan")!;
    const layers = Array.from(root.querySelectorAll<HTMLElement>(".sg-layer"));
    const N = layers.length;
    const reduce = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
    const clamp01 = (v: number) => Math.max(0, Math.min(1, v));
    const ease = (t: number) => (t < 0.5 ? 2 * t * t : 1 - Math.pow(-2 * t + 2, 2) / 2);
    const lerp = (a: number, b: number, k: number) => a + (b - a) * k;

    // card insets (inside the frame) for the "lined up with the page" state
    let ins = { t: 0, r: 0, b: 0, l: 0 };
    const RADIUS = 24;

    function layout() {
      const vw = pin.clientWidth, vh = pin.clientHeight;
      const phone = vw < 700;
      // expanded frame: the whole screen on desktop, a tall full-width band on phones
      // card: under the heading, same side edges as the other sections (6% sides, 1240px max)
      const content = phone ? vw - 32 : Math.min(1240, vw * 0.88);
      const side = (vw - content) / 2;
      const cardTop = head.offsetTop + head.offsetHeight + (phone ? 24 : 32);
      const fh = phone ? Math.min(vh * 0.7, vw * 1.1) : vh;
      // phones: the band starts right under the heading, so card and band share their top edge
      const ft = phone ? Math.max(0, Math.min(cardTop, vh - fh)) : 0;
      frame.style.top = `${ft}px`;
      frame.style.height = `${fh}px`;
      const cardH = phone ? content * 0.8 : vh - cardTop - 40;
      ins = {
        t: Math.max(0, cardTop - ft),
        r: side,
        b: Math.max(0, ft + fh - (cardTop + cardH)),
        l: side,
      };
    }

    // e: 0 = card, 1 = full screen. p: 0 = sketch ... N-1 = render
    function render(e: number, p: number) {
      const k = ease(clamp01(e));
      const r = lerp(RADIUS, 0, k);
      frame.style.clipPath = `inset(${lerp(ins.t, 0, k).toFixed(1)}px ${lerp(ins.r, 0, k).toFixed(1)}px ${lerp(ins.b, 0, k).toFixed(1)}px ${lerp(ins.l, 0, k).toFixed(1)}px round ${r.toFixed(1)}px)`;
      head.style.opacity = String((1 - k * 1.2).toFixed(3));
      // slow push in across the whole sequence
      zoom.style.transform = `scale(${(1.08 - k * 0.06 + (p / (N - 1)) * 0.04).toFixed(4)})`;

      p = Math.max(0, Math.min(N - 1, p));
      let scanAt = -1;
      layers.forEach((el, i) => {
        if (i === 0) return;
        const local = ease(clamp01(p - (i - 1)));
        el.style.clipPath = `inset(0 ${(100 - local * 100).toFixed(2)}% 0 0)`;
        if (local > 0 && local < 1) scanAt = local * 100;
      });
      scan.style.left = `${scanAt}%`;
      scan.classList.toggle("is-on", scanAt >= 0);
    }

    function onScroll() {
      if (!root.classList.contains("is-pinned")) return;
      const r = root.getBoundingClientRect();
      const total = r.height - window.innerHeight;
      const t = clamp01(-r.top / total);
      // 0 to 16%: expand. 20 to 92%: sketch to render. Then hold the render.
      const e = t / 0.16;
      const p = clamp01((t - 0.2) / 0.72) * (N - 1);
      render(e, p);
    }

    function setup() {
      root.classList.toggle("is-pinned", !reduce);
      if (!reduce) layout();
      if (reduce) render(0, N - 1);
      else onScroll();
    }
    window.addEventListener("scroll", onScroll, { passive: true });
    window.addEventListener("resize", setup);
    if (document.fonts?.ready) document.fonts.ready.then(setup);
    setup();
  }
</script>
