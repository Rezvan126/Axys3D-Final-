---
// Work tiles: real stills from the studio's own films. A tile previews its short clip on hover
// (or while on screen on touch devices) and opens the longer film in a player when selected.
// Nothing but the still is downloaded until the visitor asks for it.
// The films and their order are edited in Pages CMS (Films): src/content/films/index.json.
// Each film has a short silent preview (`clip`), an optional longer cut (`film`) and a cover picture,
// which by default is the clip's own poster next to it ("x.mp4" -> "x.webp", written by tools/process-media.mjs).
import { getEntry } from "astro:content";
import { pic, posterOf } from "../data/media";
// `cap`: on phones show the first three and a link to the rest (on by default wherever the heading is shown).
interface Props { limit?: number; heading?: boolean; feature?: boolean; cap?: boolean }
const { limit = 5, heading = true, feature = true, cap = heading } = Astro.props;
const all = (await getEntry("films", "index"))?.data.films ?? [];
const items = all
  .filter((f) => f.visible)
  .slice(0, limit)
  .map((f) => ({ ...f, film: f.film ?? f.clip, cover: pic(f.poster ?? posterOf(f.clip), undefined, { w: 1600, h: 900 }) }));
---

<section class:list={["ax-section wr ax-dark", cap && items.length > 3 && "wr--cap"]} id="work" aria-labelledby={heading ? "wrTitle" : undefined}>
  <div class="ax-wrap">
    {heading && (
      <header class="ax-head wr-head">
        <div>
          <h2 class="ax-display" id="wrTitle" data-ax>Recent work.</h2>
        </div>
        <a class="ax-link wr-all" href="/visuals/" data-ax>See all work</a>
      </header>
    )}
    <ul class="wr-grid">
      {items.map((w, i) => (
        <li class:list={["wr-item", feature && i === 0 && "wr-item--wide"]} data-ax style={`--ax-d:${(i % 2) * 0.07}s`}>
          <button type="button" class="wr-tile" data-clip={w.clip} data-film={w.film} data-title={w.title} aria-label={`Play film: ${w.title}`}>
            <img src={w.cover.src} srcset={w.cover.srcset} sizes={feature && i === 0 ? "(max-width: 1300px) 94vw, 1240px" : "(max-width: 760px) 94vw, 610px"} width={w.cover.w} height={w.cover.h} alt="" loading="lazy" decoding="async" />
            <video muted loop playsinline preload="none" aria-hidden="true" tabindex="-1"></video>
            <span class="wr-cap"><strong>{w.title}</strong><span>{w.kind}</span></span>
            <span class="wr-play" aria-hidden="true"><svg viewBox="0 0 24 24"><path d="M8 5.5v13l11-6.5z" /></svg></span>
          </button>
        </li>
      ))}
    </ul>
    {cap && items.length > 3 && <a class="ax-link wr-more" href="/visuals/">See all work</a>}
  </div>
</section>

<dialog class="wr-player ax-dark" id="wrPlayer" aria-label="Film player">
  <button type="button" class="wr-player-close" aria-label="Close film">
    <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M6 6l12 12M18 6L6 18" /></svg>
  </button>
  <video controls playsinline preload="none"></video>
  <div class="wr-player-foot">
    <p class="wr-player-title"></p>
    <a class="ax-btn ax-btn--gold ax-btn--sm" href="/contact/">Start a project</a>
  </div>
</dialog>

<style is:global>
  .wr-head { display: flex; align-items: flex-end; justify-content: space-between; gap: 16px 40px; flex-wrap: wrap; }
  .wr-grid { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: clamp(12px, 1.6vw, 20px); }
  .wr-item--wide { grid-column: 1 / -1; }
  .wr-tile { position: relative; display: block; width: 100%; margin: 0; padding: 0; border: 0; aspect-ratio: 16 / 10; border-radius: var(--ax-r-media); overflow: hidden; background: var(--ax-surface); color: #f3f0ea; font: inherit; text-align: left; cursor: pointer; }
  .wr-item--wide .wr-tile { aspect-ratio: 16 / 8; }
  .wr-tile img, .wr-tile video { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; display: block; }
  .wr-tile img { transition: transform 1.4s var(--ax-ease); }
  .wr-tile video { opacity: 0; transition: opacity 0.6s ease; }
  .wr-tile.is-playing video { opacity: 1; }
  .wr-tile:hover img { transform: scale(1.03); }
  .wr-tile::after { content: ""; position: absolute; inset: 50% 0 0 0; background: linear-gradient(180deg, transparent, rgba(0, 0, 0, 0.7)); pointer-events: none; }
  .wr-cap { position: absolute; z-index: 1; left: clamp(18px, 2.2vw, 30px); right: 76px; bottom: clamp(16px, 2vw, 26px); display: flex; flex-direction: column; gap: 4px; }
  .wr-cap strong { font-family: var(--ax-display); font-size: clamp(26px, 2.8vw, 42px); font-weight: 800; text-transform: uppercase; line-height: 0.95; }
  .wr-cap span { font: 600 13.5px/1.3 var(--ax-font); text-transform: uppercase; color: rgba(243, 240, 234, 0.82); }
  .wr-play { position: absolute; z-index: 1; right: clamp(16px, 2vw, 26px); bottom: clamp(14px, 1.8vw, 22px); display: grid; place-items: center; width: 44px; height: 44px; transition: transform 0.3s var(--ax-ease); }
  .wr-play svg { width: 28px; height: 28px; fill: #fff; transition: fill 0.2s ease; }
  .wr-tile:hover .wr-play svg { fill: var(--ax-accent); }
  .wr-more { display: none; }

  .wr-player { width: min(1200px, 100vw - 32px); max-width: none; padding: 0; border: 0; border-radius: var(--ax-r-md); background: #000; color: var(--ax-text); overflow: visible; }
  .wr-player::backdrop { background: rgba(0, 0, 0, 0.92); }
  .wr-player video { display: block; width: 100%; height: auto; max-height: calc(100vh - 140px); border-radius: var(--ax-r-md); background: #000; }
  .wr-player-foot { display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 10px 20px; padding: 12px 4px 4px; }
  .wr-player-foot .wr-player-title { margin: 0; }
  .wr-player-title { margin: 14px 4px 0; font-size: 15px; color: var(--ax-text-2); font-family: var(--ax-font); }
  .wr-player-close { position: absolute; right: 0; top: -54px; display: grid; place-items: center; width: 44px; height: 44px; border: 0; border-radius: var(--ax-r-btn-sm); background: rgba(255, 255, 255, 0.14); cursor: pointer; }
  .wr-player-close:hover { background: rgba(255, 255, 255, 0.26); }
  .wr-player-close svg { width: 18px; height: 18px; fill: none; stroke: #fff; stroke-width: 2; stroke-linecap: round; }

  @media (max-width: 760px) {
    .wr-grid { grid-template-columns: 1fr; } .wr-item--wide .wr-tile { aspect-ratio: 16 / 10; }
    /* phones: three films, then one link to the rest */
    .wr--cap .wr-item:nth-child(n + 4), .wr--cap .wr-all { display: none; }
    .wr--cap .wr-more { display: inline-flex; margin-top: 12px; }
    .wr--cap .wr-head { margin-bottom: 20px; }
  }
  @media (prefers-reduced-motion: reduce) { .wr-tile img, .wr-play { transition: none; } .wr-tile:hover img { transform: none; } }
</style>

<script>
  const tiles = Array.from(document.querySelectorAll<HTMLElement>(".wr-tile"));
  const reduce = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
  const saveData = (navigator as any).connection?.saveData === true;

  // short silent preview
  if (tiles.length && !reduce && !saveData) {
    const play = (t: HTMLElement) => {
      const v = t.querySelector("video")!;
      if (!v.src && t.dataset.clip) v.src = t.dataset.clip;
      v.play().then(() => t.classList.add("is-playing")).catch(() => {});
    };
    const stop = (t: HTMLElement) => { t.querySelector("video")!.pause(); t.classList.remove("is-playing"); };
    if (window.matchMedia("(hover: hover)").matches) {
      tiles.forEach((t) => {
        t.addEventListener("mouseenter", () => play(t)); t.addEventListener("mouseleave", () => stop(t));
        t.addEventListener("focus", () => play(t)); t.addEventListener("blur", () => stop(t));
      });
    } else {
      const io = new IntersectionObserver((es) => es.forEach((e) => (e.isIntersecting ? play(e.target as HTMLElement) : stop(e.target as HTMLElement))), { threshold: 0.7 });
      tiles.forEach((t) => io.observe(t));
    }
  }

  // the longer film, in a player
  const dlg = document.getElementById("wrPlayer") as HTMLDialogElement | null;
  if (dlg) {
    const video = dlg.querySelector("video")!;
    const title = dlg.querySelector(".wr-player-title")!;
    tiles.forEach((t) => t.addEventListener("click", () => {
      video.src = t.dataset.film || "";
      title.textContent = t.dataset.title || "";
      dlg.showModal();
      video.play().catch(() => {});
    }));
    const close = () => dlg.close();
    dlg.querySelector(".wr-player-close")!.addEventListener("click", close);
    dlg.addEventListener("click", (e) => { if (e.target === dlg) close(); });
    dlg.addEventListener("close", () => { video.pause(); video.removeAttribute("src"); video.load(); });
  }
</script>
