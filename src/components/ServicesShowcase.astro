---
// 8 services in two staggered columns. Every card rests compact; hovering (or keyboard focus,
// or a tap on touch screens) expands it, and it shrinks back when the pointer leaves.
// Used on the home page (with header) and on the Services page.
import { services } from "../data/services";

interface Props {
  showHeader?: boolean;
}
const { showHeader = false } = Astro.props;
const columns = [services.slice(0, 4), services.slice(4)];
---

<section class="sx" aria-label="Our services">
  <div class="sx-wrap">
    {showHeader && (
      <header class="sx-head">
        <div>
          <span class="sx-eyebrow">What we do</span>
          <h2 class="sx-title">
            Eight services. <em>One production team.</em>
          </h2>
        </div>
        <a href="/services" class="sx-all">
          <span>All services</span>
          <span class="sx-all-arrow" aria-hidden="true"><svg viewBox="0 0 16 16"><path d="M3 8h10M9 4l4 4-4 4" /></svg></span>
        </a>
      </header>
    )}

    <div class="sx-grid">
      {columns.map((col) => (
        <div class="sx-col">
          {col.map((s) => (
            <article class="sx-card" id={s.slug} style={`--brand:${s.logo.color}`}>
              <svg class="sx-watermark" viewBox="0 0 24 24" aria-hidden="true"><path d={s.logo.d} /></svg>

              <button class="sx-toggle" type="button" aria-expanded="false" aria-controls={`sx-body-${s.slug}`}>
                <span class="sx-num">{s.num}</span>
                <span class="sx-logo" title={s.logo.name}>
                  <svg viewBox="0 0 24 24" role="img" aria-label={s.logo.name}><path d={s.logo.d} /></svg>
                </span>
                <span class="sx-name-wrap">
                  <span class="sx-name">{s.title}</span>
                  <span class="sx-tool">{s.logo.name}</span>
                </span>
                <span class="sx-chev" aria-hidden="true"><svg viewBox="0 0 16 16"><path d="M3 8h10M9 4l4 4-4 4" /></svg></span>
              </button>

              <div class="sx-body" id={`sx-body-${s.slug}`}>
                <div class="sx-body-inner">
                  <p class="sx-blurb">{s.blurb}</p>
                  <ul class="sx-tags">
                    {s.includes.map((t) => <li>{t}</li>)}
                  </ul>
                  <a href={`/services/${s.slug}`} class="sx-link">
                    <span>Explore service</span>
                    <svg viewBox="0 0 16 16" aria-hidden="true"><path d="M3 8h10M9 4l4 4-4 4" /></svg>
                  </a>
                </div>
              </div>
            </article>
          ))}
        </div>
      ))}
    </div>
  </div>
</section>

<style>
  .sx {
    --sx-card: #101010;
    --sx-edge: rgba(255, 255, 255, 0.08);
    --sx-brown: #5b3b27;
    --sx-brown-hi: #8f6444;
    --sx-brown-lt: #b8946f;
    --sx-text: #ffffff;
    --sx-body: #cdc6c0;
    --sx-muted: #7d7773;
    --sx-ease: cubic-bezier(0.22, 1, 0.36, 1);
    position: relative;
    z-index: 2;
    padding: clamp(56px, 9vh, 110px) 0;
    font-family: "Inter", system-ui, sans-serif;
    color: var(--sx-text);
  }
  .sx-wrap { width: min(100% - 12%, 1320px); margin: 0 auto; }

  /* ---------- header (home page only) ---------- */
  .sx-head {
    display: flex; align-items: flex-end; justify-content: space-between; gap: 24px; flex-wrap: wrap;
    margin-bottom: clamp(28px, 5vh, 52px);
  }
  .sx-eyebrow {
    display: block; margin-bottom: 14px;
    font: 500 12px/1.3 "JetBrains Mono", ui-monospace, monospace;
    letter-spacing: 0.28em; text-transform: uppercase; color: var(--sx-brown-lt);
  }
  .sx-title {
    margin: 0; font-family: "Manrope", system-ui, sans-serif; font-weight: 800;
    font-size: clamp(2rem, 4.4vw, 3.5rem); line-height: 1.02; letter-spacing: -0.035em;
    text-wrap: balance;
  }
  .sx-title em { font-style: normal; color: var(--sx-brown-hi); }
  .sx-all {
    display: inline-flex; align-items: center; gap: 12px; padding: 5px 5px 5px 18px; border-radius: 999px;
    border: 1px solid var(--sx-edge); color: var(--sx-text); text-decoration: none;
    font-size: 14px; font-weight: 600; transition: border-color 0.25s ease, background 0.25s ease;
  }
  .sx-all:hover { border-color: var(--sx-brown-hi); background: rgba(143, 100, 68, 0.12); }
  .sx-all-arrow { display: grid; place-items: center; width: 34px; height: 34px; border-radius: 50%; background: rgba(255, 255, 255, 0.08); }

  /* ---------- grid: right column sits lower for a staggered rhythm ---------- */
  .sx-grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 16px; align-items: start; }
  .sx-col { display: flex; flex-direction: column; gap: 12px; min-width: 0; }

  .sx-card {
    position: relative;
    border-radius: 20px;
    border: 1px solid var(--sx-edge);
    background: var(--sx-card);
    overflow: hidden;
    isolation: isolate;
    transition: background 0.5s var(--sx-ease), border-color 0.4s ease, box-shadow 0.5s var(--sx-ease), transform 0.5s var(--sx-ease);
  }
  /* brand-tinted light from the logo corner when open */
  .sx-card::before {
    content: ""; position: absolute; inset: 0; z-index: -1; pointer-events: none;
    background: radial-gradient(70% 120% at 0% 0%, color-mix(in srgb, var(--brand) 22%, transparent), transparent 60%);
    opacity: 0; transition: opacity 0.6s ease;
  }
  .sx-card.is-open {
    background: #141110;
    border-color: color-mix(in srgb, var(--brand) 40%, rgba(255, 255, 255, 0.1));
    box-shadow: 0 28px 70px rgba(0, 0, 0, 0.6);
    transform: translateY(-2px);
  }
  .sx-card.is-open::before { opacity: 1; }

  .sx-watermark {
    position: absolute; right: -28px; bottom: -36px; z-index: -1; width: 190px; height: 190px;
    fill: var(--brand); opacity: 0; transform: rotate(-8deg) scale(0.9);
    transition: opacity 0.6s ease, transform 0.8s var(--sx-ease);
  }
  .sx-card.is-open .sx-watermark { opacity: 0.07; transform: rotate(-8deg) scale(1); }

  .sx-toggle {
    all: unset; box-sizing: border-box; cursor: pointer; width: 100%;
    display: grid; grid-template-columns: 56px auto minmax(0, 1fr) 34px; align-items: center; gap: 18px;
    padding: 16px 20px 16px 22px;
    min-height: 98px;             /* same height whether the title takes one line or two */
  }
  .sx-toggle:focus-visible { outline: 2px solid var(--sx-brown-lt); outline-offset: -4px; border-radius: 18px; }

  .sx-num {
    font-family: "Manrope", system-ui, sans-serif; font-weight: 300;
    font-size: clamp(26px, 2.2vw, 34px); line-height: 1; letter-spacing: -0.03em;
    color: #4a4643; font-variant-numeric: tabular-nums;
    transition: color 0.4s ease;
  }
  .sx-card.is-open .sx-num { color: var(--sx-brown-lt); }

  .sx-logo {
    display: grid; place-items: center;
    width: 64px; height: 64px; border-radius: 16px;
    background: linear-gradient(145deg, #1d1a18, #0d0c0b);
    border: 1px solid rgba(255, 255, 255, 0.07);
    box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.05);
    transition: width 0.6s var(--sx-ease), height 0.6s var(--sx-ease), border-color 0.4s ease, background 0.5s ease;
  }
  .sx-logo svg { width: 28px; height: 28px; fill: #d8d2cc; transition: fill 0.4s ease, transform 0.6s var(--sx-ease); }
  .sx-card:hover .sx-logo svg { fill: #fff; }
  .sx-card.is-open .sx-logo {
    width: 96px; height: 96px;
    border-color: color-mix(in srgb, var(--brand) 55%, transparent);
    background: linear-gradient(145deg, color-mix(in srgb, var(--brand) 18%, #15110f), #0d0c0b);
  }
  .sx-card.is-open .sx-logo svg { fill: var(--brand); transform: scale(1.35); }

  .sx-name-wrap { display: flex; flex-direction: column; gap: 4px; min-width: 0; }
  .sx-name {
    font-family: "Manrope", system-ui, sans-serif; font-weight: 700;
    font-size: clamp(17px, 1.45vw, 21px); line-height: 1.25; letter-spacing: -0.015em; color: #e9e4df;
    transition: color 0.3s ease;
  }
  .sx-card:hover .sx-name, .sx-card.is-open .sx-name { color: var(--sx-text); }
  .sx-tool {
    font: 500 11px/1.2 "JetBrains Mono", ui-monospace, monospace; letter-spacing: 0.1em; text-transform: uppercase;
    color: var(--sx-muted); transition: color 0.3s ease;
  }
  .sx-card.is-open .sx-tool { color: color-mix(in srgb, var(--brand) 70%, #fff); }

  .sx-chev {
    display: grid; place-items: center; width: 34px; height: 34px; border-radius: 50%;
    border: 1px solid var(--sx-edge); color: var(--sx-body);
    transition: transform 0.5s var(--sx-ease), background 0.3s ease, border-color 0.3s ease;
  }
  .sx-card.is-open .sx-chev { transform: rotate(90deg); background: var(--sx-brown); border-color: var(--sx-brown); color: #fff; }

  /* body: smooth height via grid rows */
  .sx-body { display: grid; grid-template-rows: 1fr; transition: grid-template-rows 0.6s var(--sx-ease); }
  .sx-body-inner {
    min-height: 0; overflow: hidden;
    display: flex; flex-direction: column; align-items: flex-start; gap: 14px;
    padding: 0 24px 0 calc(22px + 56px + 18px);
    transition: opacity 0.45s ease 0.12s, transform 0.55s var(--sx-ease) 0.08s, padding 0.6s var(--sx-ease);
  }
  .sx-card.is-open .sx-body-inner { padding-bottom: 24px; }
  .sx-ready .sx-card:not(.is-open) .sx-body { grid-template-rows: 0fr; }
  .sx-ready .sx-card:not(.is-open) .sx-body-inner { opacity: 0; transform: translateY(-6px); transition-delay: 0s; }

  .sx-blurb { margin: 0; max-width: 50ch; font-size: 15px; line-height: 1.6; color: var(--sx-body); }
  .sx-tags { list-style: none; margin: 0; padding: 0; display: flex; flex-wrap: wrap; gap: 8px; }
  .sx-tags li {
    padding: 6px 12px; border-radius: 999px; font-size: 12.5px; font-weight: 500; color: #e3d5c6;
    background: rgba(143, 100, 68, 0.14); border: 1px solid rgba(184, 148, 111, 0.22);
  }
  .sx-link {
    display: inline-flex; align-items: center; gap: 10px; padding: 10px 16px; border-radius: 999px;
    background: var(--sx-brown); color: #fff; text-decoration: none; font-size: 13.5px; font-weight: 600;
    transition: background 0.25s ease, gap 0.25s ease;
  }
  .sx-link:hover, .sx-link:focus-visible { background: var(--sx-brown-hi); gap: 14px; outline: none; }
  .sx svg path[d^="M3 8"] { fill: none; stroke: currentColor; stroke-width: 1.8; stroke-linecap: round; stroke-linejoin: round; }
  .sx-link svg, .sx-chev svg, .sx-all-arrow svg { width: 15px; height: 15px; }

  @media (max-width: 900px) {
    .sx-wrap { width: min(100% - 32px, 100%); }
    .sx-grid { grid-template-columns: 1fr; gap: 12px; }
    .sx-toggle { grid-template-columns: 34px auto minmax(0, 1fr) 30px; gap: 12px; padding: 14px 14px 14px 16px; }
    .sx-num { font-size: 22px; }
    .sx-logo { width: 48px; height: 48px; border-radius: 12px; }
    .sx-logo svg { width: 22px; height: 22px; }
    .sx-card.is-open .sx-logo { width: 64px; height: 64px; }
    .sx-chev { width: 30px; height: 30px; }
    .sx-body-inner { padding-left: 16px; padding-right: 16px; }
  }

  @media (prefers-reduced-motion: reduce) {
    .sx *, .sx-card, .sx-card::before { transition: none !important; }
  }
</style>

<script>
  // Desktop: a card opens while hovered and closes when the pointer leaves.
  // Keyboard: opens on focus. Touch: tap toggles, one open at a time.
  document.querySelectorAll<HTMLElement>(".sx").forEach((root) => {
    root.classList.add("sx-ready");
    const cards = Array.from(root.querySelectorAll<HTMLElement>(".sx-card"));
    const canHover = window.matchMedia("(hover: hover)").matches;

    const set = (card: HTMLElement, on: boolean) => {
      card.classList.toggle("is-open", on);
      card.querySelector(".sx-toggle")?.setAttribute("aria-expanded", String(on));
    };
    const only = (card: HTMLElement | null) => cards.forEach((c) => set(c, c === card));

    cards.forEach((card) => {
      let t: number | undefined;
      if (canHover) {
        card.addEventListener("mouseenter", () => {
          window.clearTimeout(t);
          t = window.setTimeout(() => only(card), 80);
        });
        card.addEventListener("mouseleave", () => {
          window.clearTimeout(t);
          // a mouse click leaves focus inside; drop it so the card can close
          if (card.contains(document.activeElement)) (document.activeElement as HTMLElement).blur();
          set(card, false);
        });
      }
      card.querySelector(".sx-toggle")?.addEventListener("click", () => {
        if (canHover) return; // hover already handles desktop
        only(card.classList.contains("is-open") ? null : card);
      });
      card.addEventListener("focusin", () => only(card));
      card.addEventListener("focusout", (e) => {
        if (!card.contains(e.relatedTarget as Node)) set(card, false);
      });
    });
  });
</script>
