---
// SERVICES — split showcase. Left: the 8 services as a numbered list. Right: a large panel
// for the selected service (project image, tool logo, description, deliverables, link).
// Hover, focus or tap a service to show it; the panel cross-fades, nothing else moves.
import { services } from "../data/services";

interface Props {
  showHeader?: boolean;
}
const { showHeader = false } = Astro.props;

// Images from your own projects, one per service (swap any path for a better render later)
const media: Record<string, string> = {
  "bim-production": "/images/stages/stage-3.jpg",
  "revit-production": "/images/stages/stage-2.jpg",
  "mep-coordination": "/images/stages/stage-3.jpg",
  "3d-modeling": "/images/stages/stage-2.jpg",
  "3ds-max-production": "/images/gallery/interior-1.jpg",
  "architectural-visualization": "/images/gallery/exterior-1.jpg",
  "animation-motion": "/images/gallery/video2.jpg",
  "real-time": "/images/gallery/landscape.jpg",
};
---

<section class="sv" id="services" aria-label="Our services">
  <div class="sv-wrap">
    {showHeader && (
      <header class="sv-head">
        <span class="sv-eyebrow">What we do</span>
        <h2 class="sv-title">Eight services. <em>One production team.</em></h2>
      </header>
    )}

    <div class="sv-grid">
      <!-- LEFT: list -->
      <ol class="sv-list" role="tablist" aria-label="Services" aria-orientation="vertical">
        {services.map((s, i) => (
          <li>
            <button
              class:list={["sv-item", i === 0 && "is-active"]}
              type="button"
              role="tab"
              id={`sv-tab-${s.slug}`}
              aria-controls={`sv-panel-${s.slug}`}
              aria-selected={i === 0 ? "true" : "false"}
              data-i={i}
              style={`--brand:${s.logo.color}`}
            >
              <span class="sv-num">{s.num}</span>
              <span class="sv-name">{s.title}</span>
              <span class="sv-arrow" aria-hidden="true"><svg viewBox="0 0 16 16"><path d="M3 8h10M9 4l4 4-4 4" /></svg></span>
            </button>
          </li>
        ))}
      </ol>

      <!-- RIGHT: panels (one visible at a time) -->
      <div class="sv-stage">
        {services.map((s, i) => (
          <article
            class:list={["sv-panel", i === 0 && "is-active"]}
            id={`sv-panel-${s.slug}`}
            role="tabpanel"
            aria-labelledby={`sv-tab-${s.slug}`}
            style={`--brand:${s.logo.color}`}
            hidden={i !== 0}
          >
            <div class="sv-media">
              <img src={media[s.slug]} alt="" loading={i === 0 ? "eager" : "lazy"} decoding="async" />
              <span class="sv-logo" title={s.logo.name}>
                <svg viewBox="0 0 24 24" role="img" aria-label={s.logo.name}><path d={s.logo.d} /></svg>
                <span>{s.logo.name}</span>
              </span>
              <span class="sv-count">{s.num} / 0{services.length}</span>
            </div>
            <div class="sv-body">
              <h3 class="sv-panel-title">{s.title}</h3>
              <p class="sv-short">{s.short}</p>
              <p class="sv-blurb">{s.blurb}</p>
              <ul class="sv-tags">
                {s.includes.map((t) => <li>{t}</li>)}
              </ul>
              <a href={`/services/${s.slug}`} class="sv-link">
                <span>Explore service</span>
                <span class="sv-link-arrow" aria-hidden="true"><svg viewBox="0 0 16 16"><path d="M3 8h10M9 4l4 4-4 4" /></svg></span>
              </a>
            </div>
          </article>
        ))}
      </div>
    </div>
  </div>
</section>

<style>
  .sv {
    --sv-edge: rgba(255, 255, 255, 0.08);
    --sv-brown: #5b3b27;
    --sv-brown-hi: #8f6444;
    --sv-brown-lt: #b8946f;
    --sv-sand: #d9b48c;
    --sv-text: #ffffff;
    --sv-body: #c8c1bb;
    --sv-muted: #6f6965;
    --sv-ease: cubic-bezier(0.22, 1, 0.36, 1);
    position: relative;
    padding: clamp(64px, 10vh, 120px) 0;
    color: var(--sv-text);
    font-family: "Inter", system-ui, sans-serif;
  }
  .sv-wrap { width: min(100% - 12%, 1320px); margin: 0 auto; }

  .sv-head { margin-bottom: clamp(32px, 5vh, 56px); }
  .sv-eyebrow {
    display: block; margin-bottom: 14px;
    font: 500 12px/1.3 "Inter", system-ui, sans-serif; letter-spacing: 0.28em; text-transform: uppercase; color: var(--sv-brown-lt);
  }
  .sv-title { margin: 0; }
  .sv-title em { font-style: normal; color: var(--sv-brown-hi); }

  .sv-grid { display: grid; grid-template-columns: minmax(0, 0.95fr) minmax(0, 1.05fr); gap: clamp(28px, 4vw, 64px); align-items: stretch; }

  /* ---------- list ---------- */
  .sv-list { list-style: none; margin: 0; padding: 0; border-top: 1px solid var(--sv-edge); }
  .sv-list li { border-bottom: 1px solid var(--sv-edge); }
  .sv-item {
    all: unset; box-sizing: border-box; cursor: pointer; position: relative; width: 100%;
    display: grid; grid-template-columns: 48px minmax(0, 1fr) 28px; align-items: center; gap: 14px;
    padding: 18px 8px 18px 4px;
    transition: padding 0.45s var(--sv-ease);
  }
  /* bronze bar grows from the left on the active row */
  .sv-item::before {
    content: ""; position: absolute; left: 0; right: 0; bottom: -1px; height: 1px;
    background: linear-gradient(90deg, var(--sv-sand), var(--sv-brown-hi) 60%, transparent);
    transform: scaleX(0); transform-origin: left; transition: transform 0.6s var(--sv-ease);
  }
  .sv-item.is-active::before { transform: scaleX(1); }
  .sv-item:hover, .sv-item.is-active { padding-left: 14px; }
  .sv-item:focus-visible { outline: 2px solid var(--sv-sand); outline-offset: 2px; border-radius: 8px; }

  .sv-num { font: 500 13px/1 "Inter", system-ui, sans-serif; letter-spacing: 0.08em; color: var(--sv-muted); font-variant-numeric: tabular-nums; transition: color 0.3s ease; }
  .sv-name {
    font-family: "Manrope", system-ui, sans-serif; font-weight: 700;
    font-size: clamp(18px, 1.7vw, 24px); line-height: 1.2; letter-spacing: -0.02em; color: #7d7773;
    transition: color 0.3s ease;
  }
  .sv-item:hover .sv-name { color: #d8d2cc; }
  .sv-item.is-active .sv-name { color: var(--sv-text); }
  .sv-item.is-active .sv-num { color: var(--sv-sand); }
  .sv-arrow { display: grid; place-items: center; width: 28px; height: 28px; border-radius: 50%; color: var(--sv-sand); opacity: 0; transform: translateX(-8px); transition: opacity 0.3s ease, transform 0.45s var(--sv-ease); }
  .sv-item.is-active .sv-arrow { opacity: 1; transform: none; }

  /* ---------- stage ---------- */
  .sv-stage { position: relative; min-height: 560px; }
  .sv-panel {
    position: absolute; inset: 0; display: grid; grid-template-rows: minmax(0, 1fr) auto;
    border-radius: 24px; overflow: hidden;
    border: 1px solid color-mix(in srgb, var(--brand) 30%, rgba(255, 255, 255, 0.1));
    background: linear-gradient(180deg, #151210 0%, #0e0c0b 100%);
    box-shadow: 0 40px 90px rgba(0, 0, 0, 0.55);
    opacity: 0; transform: translateY(10px); transition: opacity 0.5s ease, transform 0.6s var(--sv-ease);
  }
  .sv-panel[hidden] { display: grid; visibility: hidden; }
  .sv-panel.is-active { opacity: 1; transform: none; visibility: visible; }

  .sv-media { position: relative; min-height: 0; overflow: hidden; }
  .sv-media img { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; transform: scale(1.06); transition: transform 1.4s var(--sv-ease); }
  .sv-panel.is-active .sv-media img { transform: scale(1); }
  .sv-media::after { content: ""; position: absolute; inset: 0; background: linear-gradient(180deg, rgba(0, 0, 0, 0.35) 0%, transparent 30%, transparent 60%, #151210 100%); }
  .sv-logo {
    position: absolute; z-index: 2; left: 18px; top: 18px; display: inline-flex; align-items: center; gap: 10px;
    padding: 7px 14px 7px 8px; border-radius: 999px;
    background: rgba(10, 8, 7, 0.65); border: 1px solid rgba(255, 255, 255, 0.14);
    backdrop-filter: blur(10px); -webkit-backdrop-filter: blur(10px);
    font-size: 12.5px; font-weight: 600; color: #f1e2d1;
  }
  .sv-logo svg { width: 26px; height: 26px; padding: 4px; border-radius: 50%; background: color-mix(in srgb, var(--brand) 25%, #15110f); fill: color-mix(in srgb, var(--brand) 75%, #fff); box-sizing: border-box; }
  .sv-count { position: absolute; z-index: 2; right: 18px; top: 22px; padding: 7px 12px; border-radius: 999px; background: rgba(10, 8, 7, 0.65); border: 1px solid rgba(255, 255, 255, 0.14); backdrop-filter: blur(10px); -webkit-backdrop-filter: blur(10px); font-size: 12px; font-weight: 600; letter-spacing: 0.12em; color: #f1e2d1; font-variant-numeric: tabular-nums; }

  .sv-body { position: relative; display: flex; flex-direction: column; align-items: flex-start; gap: 12px; padding: 4px 28px 28px; }
  .sv-panel-title { margin: 0; }
  .sv-short { margin: 0; font-size: 14px; font-weight: 600; color: var(--sv-sand); }
  .sv-blurb { margin: 0; max-width: 52ch; font-size: 15px; line-height: 1.6; color: var(--sv-body); }
  .sv-tags { list-style: none; margin: 2px 0 0; padding: 0; display: flex; flex-wrap: wrap; gap: 8px; }
  .sv-tags li { padding: 6px 12px; border-radius: 999px; font-size: 12.5px; font-weight: 500; color: #e3d5c6; background: rgba(143, 100, 68, 0.14); border: 1px solid rgba(184, 148, 111, 0.22); }
  .sv-link {
    margin-top: 6px; display: inline-flex; align-items: center; gap: 14px; padding: 5px 5px 5px 18px; border-radius: 999px;
    background: var(--sv-brown); color: #fff; text-decoration: none; font-size: 14px; font-weight: 600;
    transition: background 0.25s ease;
  }
  .sv-link:hover, .sv-link:focus-visible { background: var(--sv-brown-hi); outline: none; }
  .sv-link-arrow { display: grid; place-items: center; width: 34px; height: 34px; border-radius: 50%; background: rgba(255, 255, 255, 0.16); transition: transform 0.35s var(--sv-ease); }
  .sv-link:hover .sv-link-arrow { transform: translateX(3px); }
  .sv svg path[d^="M3 8"] { fill: none; stroke: currentColor; stroke-width: 1.8; stroke-linecap: round; stroke-linejoin: round; }
  .sv-arrow svg, .sv-link-arrow svg { width: 15px; height: 15px; }

  /* ---------- phones: list on top, panel below ---------- */
  @media (max-width: 900px) {
    .sv-wrap { width: min(100% - 32px, 100%); }
    .sv-grid { grid-template-columns: 1fr; }
    .sv-stage { min-height: 520px; }
    .sv-item { padding: 14px 4px; grid-template-columns: 36px minmax(0, 1fr) 24px; }
    .sv-item:hover, .sv-item.is-active { padding-left: 8px; }
    .sv-body { padding: 4px 18px 20px; }
  }
  @media (prefers-reduced-motion: reduce) {
    .sv-item, .sv-item::before, .sv-panel, .sv-media img, .sv-arrow { transition: none !important; }
  }
</style>

<script>
  document.querySelectorAll<HTMLElement>(".sv").forEach((root) => {
    const tabs = Array.from(root.querySelectorAll<HTMLButtonElement>(".sv-item"));
    const panels = Array.from(root.querySelectorAll<HTMLElement>(".sv-panel"));
    let current = 0;
    const show = (i: number) => {
      if (i === current) return;
      current = i;
      tabs.forEach((t, k) => {
        t.classList.toggle("is-active", k === i);
        t.setAttribute("aria-selected", String(k === i));
        t.tabIndex = k === i ? 0 : -1;
      });
      panels.forEach((p, k) => {
        p.classList.toggle("is-active", k === i);
        if (k === i) p.hidden = false;
        else window.setTimeout(() => { if (!p.classList.contains("is-active")) p.hidden = true; }, 500);
      });
    };
    tabs.forEach((t, i) => {
      t.tabIndex = i === 0 ? 0 : -1;
      t.addEventListener("mouseenter", () => { if (window.matchMedia("(hover: hover)").matches) show(i); });
      t.addEventListener("focus", () => show(i));
      t.addEventListener("click", () => {
        show(i);
        // phones: the panel sits below the list, so bring it into view
        if (window.matchMedia("(max-width: 900px)").matches) panels[i].scrollIntoView({ behavior: "smooth", block: "center" });
      });
      t.addEventListener("keydown", (e) => {
        const n = e.key === "ArrowDown" ? i + 1 : e.key === "ArrowUp" ? i - 1 : -1;
        if (n >= 0 && n < tabs.length) { e.preventDefault(); tabs[n].focus(); }
      });
    });
  });
</script>
