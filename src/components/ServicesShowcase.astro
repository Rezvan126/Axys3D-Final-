---
// 8 services as two columns of expanding cards. One card per column is open at a time;
// hover, keyboard focus or tap opens it. Used on the home page (with header) and the Services page.
import { services } from "../data/services";

interface Props {
  showHeader?: boolean;
}
const { showHeader = false } = Astro.props;
const columns = [services.slice(0, 4), services.slice(4)];
---

<section class="sx" aria-label="Our services">
  <div class="sx-wrap">
    {showHeader && (
      <header class="sx-head">
        <div>
          <span class="sx-eyebrow">What we do</span>
          <h2 class="sx-title">
            Eight services. <em>One production team.</em>
          </h2>
        </div>
        <a href="/services" class="sx-all">
          <span>All services</span>
          <svg viewBox="0 0 16 16" aria-hidden="true"><path d="M3 8h10M9 4l4 4-4 4" /></svg>
        </a>
      </header>
    )}

    <div class="sx-grid">
      {columns.map((col) => (
        <div class="sx-col">
          {col.map((s, idx) => (
            <article class:list={["sx-card", idx === 0 && "is-open"]} id={s.slug}>
              <button class="sx-toggle" type="button" aria-expanded={idx === 0 ? "true" : "false"} aria-controls={`sx-body-${s.slug}`}>
                <span class="sx-num">{s.num}</span>
                <span class="sx-media" aria-hidden="true">
                  <svg class="sx-icon" viewBox="0 0 24 24"><path d={s.icon} /></svg>
                  <img src={s.image} alt="" loading="lazy" decoding="async" onerror="this.remove()" />
                </span>
                <span class="sx-name">{s.title}</span>
                <span class="sx-plus" aria-hidden="true"></span>
              </button>
              <div class="sx-body" id={`sx-body-${s.slug}`}>
                <div class="sx-body-inner">
                  <p class="sx-blurb">{s.blurb}</p>
                  <ul class="sx-tags">
                    {s.includes.map((t) => <li>{t}</li>)}
                  </ul>
                  <a href={`/services/${s.slug}`} class="sx-link">
                    <span>Explore service</span>
                    <svg viewBox="0 0 16 16" aria-hidden="true"><path d="M3 8h10M9 4l4 4-4 4" /></svg>
                  </a>
                </div>
              </div>
            </article>
          ))}
        </div>
      ))}
    </div>
  </div>
</section>

<style>
  .sx {
    --sx-bg: #0d0d0d;
    --sx-card: #121212;
    --sx-open: #171310;
    --sx-edge: rgba(255, 255, 255, 0.08);
    --sx-brown: #5b3b27;
    --sx-brown-hi: #8f6444;
    --sx-brown-lt: #b8946f;
    --sx-text: #ffffff;
    --sx-body: #cdc6c0;
    --sx-muted: #8d8784;
    --sx-ease: cubic-bezier(0.22, 1, 0.36, 1);
    position: relative;
    z-index: 2;
    padding: clamp(56px, 9vh, 110px) 0;
    font-family: "Inter", system-ui, sans-serif;
    color: var(--sx-text);
  }
  .sx-wrap { width: min(100% - 12%, 1320px); margin: 0 auto; }

  /* ---------- header (home page only) ---------- */
  .sx-head {
    display: flex; align-items: flex-end; justify-content: space-between; gap: 24px; flex-wrap: wrap;
    margin-bottom: clamp(28px, 5vh, 48px);
  }
  .sx-eyebrow {
    display: block; margin-bottom: 14px;
    font: 500 12px/1.3 "JetBrains Mono", ui-monospace, monospace;
    letter-spacing: 0.28em; text-transform: uppercase; color: var(--sx-brown-lt);
  }
  .sx-title {
    margin: 0; font-family: "Manrope", system-ui, sans-serif; font-weight: 800;
    font-size: clamp(2rem, 4.4vw, 3.5rem); line-height: 1.02; letter-spacing: -0.035em;
    text-wrap: balance;
  }
  .sx-title em { font-style: normal; color: var(--sx-brown-hi); }
  .sx-all {
    display: inline-flex; align-items: center; gap: 10px; padding: 11px 18px; border-radius: 999px;
    border: 1px solid var(--sx-edge); color: var(--sx-text); text-decoration: none;
    font-size: 14px; font-weight: 600; transition: border-color 0.25s ease, background 0.25s ease;
  }
  .sx-all:hover { border-color: var(--sx-brown-hi); background: rgba(143, 100, 68, 0.12); }

  /* ---------- grid ---------- */
  .sx-grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 16px; align-items: start; }
  .sx-col { display: flex; flex-direction: column; gap: 12px; min-width: 0; }

  .sx-card {
    position: relative;
    border-radius: 20px;
    border: 1px solid var(--sx-edge);
    background: var(--sx-card);
    overflow: hidden;
    transition: background 0.5s var(--sx-ease), border-color 0.4s ease, box-shadow 0.5s var(--sx-ease);
  }
  /* bronze rail that grows down the left edge of the open card */
  .sx-card::before {
    content: ""; position: absolute; left: 0; top: 0; bottom: 0; width: 3px;
    background: linear-gradient(180deg, var(--sx-brown-lt), var(--sx-brown));
    transform: scaleY(0); transform-origin: top; transition: transform 0.6s var(--sx-ease);
  }
  .sx-card:hover { border-color: rgba(143, 100, 68, 0.45); }
  .sx-card.is-open {
    background: var(--sx-open);
    border-color: rgba(143, 100, 68, 0.5);
    box-shadow: 0 24px 60px rgba(0, 0, 0, 0.55), inset 0 1px 0 rgba(255, 255, 255, 0.04);
  }
  .sx-card.is-open::before { transform: scaleY(1); }

  .sx-toggle {
    all: unset; box-sizing: border-box; cursor: pointer; width: 100%;
    display: grid; grid-template-columns: 44px auto minmax(0, 1fr) 28px; align-items: center; gap: 18px;
    padding: 16px 22px 16px 24px;
  }
  .sx-toggle:focus-visible { outline: 2px solid var(--sx-brown-lt); outline-offset: -4px; border-radius: 18px; }

  .sx-num {
    font: 500 15px/1 "JetBrains Mono", ui-monospace, monospace; color: var(--sx-muted);
    transition: color 0.3s ease;
  }
  .sx-card.is-open .sx-num { color: var(--sx-brown-lt); }

  .sx-media {
    position: relative; display: grid; place-items: center; overflow: hidden;
    width: 72px; height: 52px; border-radius: 12px;
    background: radial-gradient(120% 120% at 30% 20%, #3a2518 0%, #1a1411 70%);
    border: 1px solid rgba(255, 255, 255, 0.06);
    transition: width 0.6s var(--sx-ease), height 0.6s var(--sx-ease);
  }
  .sx-card.is-open .sx-media { width: 128px; height: 96px; }
  .sx-media img {
    position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover;
    transform: scale(1.12); transition: transform 0.9s var(--sx-ease);
  }
  .sx-card.is-open .sx-media img { transform: scale(1); }
  .sx-icon {
    width: 24px; height: 24px; fill: none; stroke: var(--sx-brown-lt); stroke-width: 1.5;
    stroke-linecap: round; stroke-linejoin: round;
  }

  .sx-name {
    font-family: "Manrope", system-ui, sans-serif; font-weight: 700;
    font-size: clamp(17px, 1.45vw, 21px); line-height: 1.25; letter-spacing: -0.015em; color: #e9e4df;
    transition: color 0.3s ease;
  }
  .sx-card.is-open .sx-name, .sx-card:hover .sx-name { color: var(--sx-text); }

  /* plus turns into a minus when open */
  .sx-plus { position: relative; width: 28px; height: 28px; border-radius: 50%; border: 1px solid var(--sx-edge); transition: background 0.3s ease, border-color 0.3s ease; }
  .sx-plus::before, .sx-plus::after {
    content: ""; position: absolute; left: 50%; top: 50%; width: 11px; height: 1.5px; border-radius: 2px;
    background: var(--sx-body); transform: translate(-50%, -50%); transition: transform 0.4s var(--sx-ease);
  }
  .sx-plus::after { transform: translate(-50%, -50%) rotate(90deg); }
  .sx-card.is-open .sx-plus { background: var(--sx-brown); border-color: var(--sx-brown); }
  .sx-card.is-open .sx-plus::after { transform: translate(-50%, -50%) rotate(0deg); }

  /* body: smooth height via grid rows */
  .sx-body { display: grid; grid-template-rows: 1fr; transition: grid-template-rows 0.6s var(--sx-ease); }
  .sx-body-inner {
    min-height: 0; overflow: hidden;
    display: flex; flex-direction: column; align-items: flex-start; gap: 14px;
    padding: 0 24px 0 calc(24px + 44px + 18px);
    transition: opacity 0.4s ease 0.12s, transform 0.5s var(--sx-ease) 0.08s, padding 0.6s var(--sx-ease);
  }
  .sx-card.is-open .sx-body-inner { padding-bottom: 22px; }
  .sx-ready .sx-card:not(.is-open) .sx-body { grid-template-rows: 0fr; }
  .sx-ready .sx-card:not(.is-open) .sx-body-inner { opacity: 0; transform: translateY(-6px); transition-delay: 0s; }

  .sx-blurb { margin: 0; max-width: 52ch; font-size: 15px; line-height: 1.6; color: var(--sx-body); }
  .sx-tags { list-style: none; margin: 0; padding: 0; display: flex; flex-wrap: wrap; gap: 8px; }
  .sx-tags li {
    padding: 6px 12px; border-radius: 999px; font-size: 12.5px; font-weight: 500; color: #e3d5c6;
    background: rgba(143, 100, 68, 0.14); border: 1px solid rgba(184, 148, 111, 0.22);
  }
  .sx-link {
    display: inline-flex; align-items: center; gap: 10px; padding: 10px 16px; border-radius: 999px;
    background: var(--sx-brown); color: #fff; text-decoration: none; font-size: 13.5px; font-weight: 600;
    transition: background 0.25s ease, gap 0.25s ease;
  }
  .sx-link:hover, .sx-link:focus-visible { background: var(--sx-brown-hi); gap: 14px; outline: none; }
  .sx svg:not(.sx-icon) { width: 15px; height: 15px; fill: none; stroke: currentColor; stroke-width: 1.8; stroke-linecap: round; stroke-linejoin: round; }

  @media (max-width: 900px) {
    .sx-wrap { width: min(100% - 32px, 100%); }
    .sx-grid { grid-template-columns: 1fr; gap: 12px; }
    .sx-toggle { grid-template-columns: 30px auto minmax(0, 1fr) 28px; gap: 12px; padding: 14px 14px 14px 16px; }
    .sx-media { width: 56px; height: 44px; }
    .sx-card.is-open .sx-media { width: 88px; height: 68px; }
    .sx-body-inner { padding-left: 16px; padding-right: 16px; }
    .sx-num { font-size: 13px; }
  }

  @media (prefers-reduced-motion: reduce) {
    .sx *, .sx-card, .sx-card::before { transition: none !important; }
  }
</style>

<script>
  // Hover (with a short delay to avoid flicker), focus or tap opens a card.
  document.querySelectorAll<HTMLElement>(".sx").forEach((root) => {
    root.classList.add("sx-ready");
    const canHover = window.matchMedia("(hover: hover)").matches;
    // Two columns side by side: one open card per column. Stacked on phones: one open card overall.
    const stacked = window.matchMedia("(max-width: 900px)").matches;
    if (stacked) root.querySelectorAll<HTMLElement>(".sx-col:not(:first-child) .sx-card.is-open").forEach((c) => {
      c.classList.remove("is-open");
      c.querySelector(".sx-toggle")?.setAttribute("aria-expanded", "false");
    });
    const groups: HTMLElement[] = stacked ? [root] : Array.from(root.querySelectorAll<HTMLElement>(".sx-col"));
    groups.forEach((col) => {
      const cards = Array.from(col.querySelectorAll<HTMLElement>(".sx-card"));
      const open = (card: HTMLElement) =>
        cards.forEach((c) => {
          const on = c === card;
          c.classList.toggle("is-open", on);
          c.querySelector(".sx-toggle")?.setAttribute("aria-expanded", String(on));
        });
      cards.forEach((card) => {
        let t: number | undefined;
        card.addEventListener("mouseenter", () => {
          if (!canHover) return;
          window.clearTimeout(t);
          t = window.setTimeout(() => open(card), 90);
        });
        card.addEventListener("mouseleave", () => window.clearTimeout(t));
        card.querySelector(".sx-toggle")?.addEventListener("click", () => open(card));
        card.addEventListener("focusin", () => open(card));
      });
    });
  });
</script>
