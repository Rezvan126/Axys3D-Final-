---
// SERVICES: eight image cards. Idea: "from model to finished result". Each image rests in a
// muted model state; on hover a bronze scan line sweeps across and reveals the full render, then
// the project film plays where one exists. Text sits in its own block under the image.
import { services } from "../data/services";

interface Props {
  showHeader?: boolean;
}
const { showHeader = false } = Astro.props;

// One image per service (from your projects), and a film where a matching one exists
const media: Record<string, { img: string; video?: string }> = {
  "bim-production": { img: "/images/services/bim.jpg" },
  "revit-production": { img: "/images/services/revit.jpg" },
  "mep-coordination": { img: "/images/services/mep.jpg" },
  "3d-modeling": { img: "/images/services/modeling.jpg" },
  "3ds-max-production": { img: "/images/services/max.jpg", video: "/videos/services/max.mp4" },
  "architectural-visualization": { img: "/images/services/archviz.jpg", video: "/videos/services/archviz.mp4" },
  "animation-motion": { img: "/images/services/animation.jpg", video: "/videos/services/animation.mp4" },
  "real-time": { img: "/images/services/realtime.jpg", video: "/videos/services/realtime.mp4" },
};
---

<section class="sx" id="services" aria-labelledby="sxTitle">
  <div class="sx-wrap">
    {showHeader && (
      <header class="sx-head">
        <h2 class="sx-title" id="sxTitle">Eight services. <em>One production team.</em></h2>
        <p class="sx-lead"><span class="sx-hint-hover">Hover</span><span class="sx-hint-tap">Scroll through</span> the services and watch each model turn into the finished result.</p>
      </header>
    )}

    <div class="sx-grid">
      {services.map((s, i) => {
        const m = media[s.slug];
        return (
          <a class={`sx-card sx-c${i}`} href={`/services/${s.slug}`}>
            <div class="sx-media">
              <img class="sx-img sx-img--model" src={m.img} alt="" aria-hidden="true" loading="lazy" decoding="async" />
              <div class="sx-render">
                <img class="sx-img" src={m.img} alt={`${s.title}: project image`} loading="lazy" decoding="async" />
                {m.video && <video class="sx-video" muted loop playsinline preload="none" data-src={m.video} aria-hidden="true"></video>}
              </div>
              <span class="sx-scan" aria-hidden="true"></span>
              <span class="sx-glare" aria-hidden="true"></span>
            </div>
            <div class="sx-body">
              <div class="sx-meta">
                <span class="sx-tool"><svg viewBox="0 0 24 24" aria-hidden="true"><path d={s.logo.d} /></svg>{s.logo.name}</span>
                <span class="sx-num">{s.num}</span>
              </div>
              <h3 class="sx-name">{s.title}</h3>
              <p class="sx-short">{s.short}</p>
              <span class="sx-more">Explore service <svg viewBox="0 0 16 16" aria-hidden="true"><path d="M3 8h10M9 4l4 4-4 4" /></svg></span>
            </div>
          </a>
        );
      })}
    </div>
  </div>
</section>

<style>
  .sx {
    --sx-edge: rgba(255, 255, 255, 0.08);
    --sx-brown: #5b3b27;
    --sx-brown-hi: #8f6444;
    --sx-brown-lt: #b8946f;
    --sx-sand: #d9b48c;
    --sx-ease: cubic-bezier(0.22, 1, 0.36, 1);
    position: relative;
    padding: clamp(64px, 10vh, 120px) 0;
    color: #fff;
    font-family: "Inter", system-ui, sans-serif;
  }
  .sx-wrap { width: min(100% - 12%, 1320px); margin: 0 auto; }
  .sx-head { display: flex; flex-direction: column; gap: 14px; max-width: 980px; margin-bottom: clamp(32px, 5vh, 52px); }
  .sx-title { margin: 0; }
  .sx-title em { font-style: normal; color: var(--sx-brown-hi); }
  .sx-lead { margin: 0; font-size: 17px; line-height: 1.6; color: #a49e9a; }
  .sx-hint-tap { display: none; }
  @media (hover: none) { .sx-hint-hover { display: none; } .sx-hint-tap { display: inline; } }

  /* three rows with a rhythm: wide + two, two + wide, wide + wide */
  .sx-grid { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 20px; perspective: 1200px; }
  .sx-c0, .sx-c5, .sx-c6, .sx-c7 { grid-column: span 2; }

  /* ---------- card ---------- */
  .sx-card {
    --rx: 0deg; --ry: 0deg; --mx: 50%; --my: 50%;
    position: relative; display: flex; flex-direction: column; min-width: 0;
    border-radius: 22px; overflow: hidden; text-decoration: none; color: inherit;
    background: #121010; border: 1px solid var(--sx-edge);
    box-shadow: 0 20px 50px rgba(0, 0, 0, 0.45);
    transform: rotateX(var(--rx)) rotateY(var(--ry)) translateY(0);
    transform-style: preserve-3d;
    transition: transform 0.5s var(--sx-ease), border-color 0.4s ease, box-shadow 0.5s ease;
  }
  .sx-card.is-on { border-color: rgba(217, 180, 140, 0.45); box-shadow: 0 30px 70px rgba(0, 0, 0, 0.6), 0 0 0 1px rgba(217, 180, 140, 0.12); }
  .sx-card.is-hover { transform: rotateX(var(--rx)) rotateY(var(--ry)) translateY(-6px); transition: transform 0.15s linear, border-color 0.4s ease, box-shadow 0.5s ease; }
  .sx-card:focus-visible { outline: 2px solid var(--sx-sand); outline-offset: 4px; }

  /* image: muted model state underneath, full render revealed on top */
  .sx-media { position: relative; height: 260px; overflow: hidden; background: #0b0a0a; }
  .sx-img { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; transform: scale(1.02); transition: transform 1.2s var(--sx-ease); }
  .sx-img--model { filter: grayscale(1) contrast(1.05) brightness(0.8); }
  .sx-render { position: absolute; inset: 0; clip-path: inset(0 100% 0 0); transition: clip-path 0.9s var(--sx-ease); }
  .sx-card.is-on .sx-render { clip-path: inset(0 0 0 0); }
  .sx-card.is-on .sx-img { transform: scale(1.07); }
  .sx-video { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; opacity: 0; transition: opacity 0.6s ease 0.5s; }
  .sx-card.is-on .sx-video.is-ready { opacity: 1; }
  /* the bronze scan line travels with the reveal edge */
  .sx-scan {
    position: absolute; top: 0; bottom: 0; left: 0; width: 2px; pointer-events: none;
    background: linear-gradient(180deg, transparent, var(--sx-sand) 15%, var(--sx-sand) 85%, transparent);
    box-shadow: 0 0 16px 2px rgba(217, 180, 140, 0.65);
    opacity: 0; transform: translateX(0); transition: transform 0.9s var(--sx-ease), opacity 0.3s ease 0.6s;
  }
  .sx-card.is-on .sx-scan { transform: translateX(calc(var(--w, 600px) - 2px)); opacity: 0; }
  .sx-card.is-scanning .sx-scan { opacity: 1; transition: transform 0.9s var(--sx-ease), opacity 0.1s ease; }
  /* soft light that follows the cursor */
  .sx-glare { position: absolute; inset: 0; pointer-events: none; opacity: 0; transition: opacity 0.4s ease; background: radial-gradient(420px circle at var(--mx) var(--my), rgba(255, 240, 220, 0.16), transparent 45%); }
  .sx-card.is-hover .sx-glare { opacity: 1; }

  /* text block under the image */
  .sx-body { position: relative; display: flex; flex-direction: column; gap: 8px; flex: 1; padding: 20px 24px 22px; border-top: 1px solid var(--sx-edge); background: linear-gradient(180deg, #151210, #110f0e); }
  .sx-meta { display: flex; align-items: center; justify-content: space-between; gap: 12px; }
  .sx-tool { display: inline-flex; align-items: center; gap: 8px; font-size: 12px; font-weight: 600; letter-spacing: 0.04em; color: var(--sx-brown-lt); }
  .sx-tool svg { width: 17px; height: 17px; fill: var(--sx-sand); }
  .sx-num { font-size: 12px; font-weight: 600; letter-spacing: 0.12em; color: #6f6965; font-variant-numeric: tabular-nums; transition: color 0.3s ease; }
  .sx-card.is-on .sx-num { color: var(--sx-sand); }
  .sx-name { margin: 0; }
  .sx-short { margin: 0; font-size: 14.5px; line-height: 1.5; color: #b9b2ac; }
  .sx-more { margin-top: auto; padding-top: 10px; display: inline-flex; align-items: center; gap: 8px; font-size: 13.5px; font-weight: 600; color: var(--sx-sand); }
  .sx-more svg { width: 14px; height: 14px; fill: none; stroke: currentColor; stroke-width: 1.8; stroke-linecap: round; stroke-linejoin: round; transition: transform 0.35s var(--sx-ease); }
  .sx-card.is-on .sx-more svg { transform: translateX(4px); }

  @media (max-width: 1100px) {
    .sx-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    .sx-c0, .sx-c5, .sx-c6, .sx-c7 { grid-column: span 1; }
  }
  @media (max-width: 640px) {
    .sx-wrap { width: min(100% - 32px, 100%); }
    .sx-grid { grid-template-columns: 1fr; gap: 16px; }
    .sx-media { height: 210px; }
    .sx-lead { font-size: 16px; }
    .sx-body { padding: 18px 18px 20px; }
  }
  @media (prefers-reduced-motion: reduce) {
    .sx-card, .sx-render, .sx-img, .sx-scan, .sx-video { transition: none !important; }
    .sx-render { clip-path: none; }
    .sx-img--model { display: none; }
  }
</style>

<script>
  const reduce = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
  const canHover = window.matchMedia("(hover: hover) and (pointer: fine)").matches;

  document.querySelectorAll<HTMLElement>(".sx-card").forEach((card) => {
    const media = card.querySelector<HTMLElement>(".sx-media");
    const video = card.querySelector<HTMLVideoElement>(".sx-video");
    let scanTimer = 0;

    const turnOn = () => {
      if (card.classList.contains("is-on")) return;
      if (media) card.style.setProperty("--w", `${media.offsetWidth}px`);
      card.classList.add("is-scanning");
      // let the line appear at the left edge, then sweep
      requestAnimationFrame(() => card.classList.add("is-on"));
      window.clearTimeout(scanTimer);
      scanTimer = window.setTimeout(() => card.classList.remove("is-scanning"), 900);
      if (video && canHover && !reduce) {
        if (!video.src) {
          video.src = video.dataset.src || "";
          video.addEventListener("canplay", () => video.classList.add("is-ready"), { once: true });
        }
        video.play().catch(() => {});
      }
    };
    const turnOff = () => {
      card.classList.remove("is-on", "is-scanning", "is-hover");
      card.style.setProperty("--rx", "0deg");
      card.style.setProperty("--ry", "0deg");
      if (video) video.pause();
    };

    if (canHover) {
      card.addEventListener("pointerenter", () => { card.classList.add("is-hover"); turnOn(); });
      card.addEventListener("pointerleave", turnOff);
      if (!reduce) {
        card.addEventListener("pointermove", (e) => {
          const r = card.getBoundingClientRect();
          const x = (e.clientX - r.left) / r.width, y = (e.clientY - r.top) / r.height;
          card.style.setProperty("--ry", `${(x - 0.5) * 6}deg`);
          card.style.setProperty("--rx", `${(0.5 - y) * 6}deg`);
          card.style.setProperty("--mx", `${x * 100}%`);
          card.style.setProperty("--my", `${y * 100}%`);
        });
      }
      card.addEventListener("focus", turnOn);
      card.addEventListener("blur", turnOff);
    }
  });

  // touch screens: each card renders by itself as it scrolls into view
  if (!canHover) {
    const io = new IntersectionObserver((entries) => {
      entries.forEach((en) => {
        if (!en.isIntersecting) return;
        const card = en.target as HTMLElement;
        const media = card.querySelector<HTMLElement>(".sx-media");
        if (media) card.style.setProperty("--w", `${media.offsetWidth}px`);
        card.classList.add("is-scanning");
        requestAnimationFrame(() => card.classList.add("is-on"));
        window.setTimeout(() => card.classList.remove("is-scanning"), 900);
        io.unobserve(card);
      });
    }, { threshold: 0.55 });
    document.querySelectorAll(".sx-card").forEach((c) => io.observe(c));
  }
</script>
