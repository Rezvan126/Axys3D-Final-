---
import "../styles/Hero.css";

// HERO — left: headline. Right: a building is shown as a line drawing, a scan line
// sweeps across and turns it into the real render, then the film plays. Loops.
// Files: public/images/hero/lines.jpg, public/images/hero/render.jpg, public/videos/hero-reveal.mp4
---

<section class="hx" id="axysHero">
<div class="hx-bg" aria-hidden="true"></div>

  <div class="hx-inner">
    <!-- LEFT: copy -->
    <div class="hx-copy">
      <div class="hx-eyebrow">
        <span class="hx-eyebrow-dot" aria-hidden="true"></span>
        Full service
        <span class="hx-term" tabindex="0" data-tip="AEC = Architecture, Engineering & Construction. In simple words: the building industry.">AEC</span>
        production partner
      </div>

      <h1 class="hx-title">
        <span class="hx-line" style="--d:0">AEC production</span>
        <span class="hx-line" style="--d:1">without the</span>
        <span class="hx-line hx-accent" style="--d:2">production friction.</span>
      </h1>

      <p class="hx-lead">
        BIM models, permit-ready Revit sets and photoreal renders, built to your
        standards and checked before they reach you. One team from first sketch to final film.
      </p>

      <div class="hx-buttons">
        <a href="#services" class="hx-btn hx-btn--primary">
          <span>Review the full pipeline</span>
          <span class="hx-btn-arrow" aria-hidden="true"><svg viewBox="0 0 16 16"><path d="M3 8h10M9 4l4 4-4 4" /></svg></span>
        </a>
        <a href="/contact" class="hx-btn hx-btn--ghost">
          <span>Discuss a production package</span>
          <span class="hx-btn-arrow" aria-hidden="true"><svg viewBox="0 0 16 16"><path d="M3 8h10M9 4l4 4-4 4" /></svg></span>
        </a>
      </div>
    </div>

  </div>
</section>
