---
import "../styles/Hero.css";

// HERO — left: headline. Right: a building is shown as a line drawing, a scan line
// sweeps across and turns it into the real render, then the film plays. Loops.
// Files: public/images/hero/lines.jpg, public/images/hero/render.jpg, public/videos/hero-reveal.mp4
---

<section class="hx" id="axysHero">
<div class="hx-bg" aria-hidden="true"></div>

  <div class="hx-inner">
    <!-- LEFT: copy -->
    <div class="hx-copy">
      <div class="hx-eyebrow">
        <span class="hx-eyebrow-dot" aria-hidden="true"></span>
        Full service
        <span class="hx-term" tabindex="0" data-tip="AEC = Architecture, Engineering & Construction. In simple words: the building industry.">AEC</span>
        production partner
      </div>

      <h1 class="hx-title">
        <span class="hx-line" style="--d:0">AEC production</span>
        <span class="hx-line" style="--d:1">without the</span>
        <span class="hx-line hx-accent" style="--d:2">production friction.</span>
      </h1>

      <p class="hx-lead">
        BIM models, permit-ready Revit sets and photoreal renders, built to your
        standards and checked before they reach you. One team from first sketch to final film.
      </p>

      <div class="hx-buttons">
        <a href="/services" class="hx-btn hx-btn--primary">
          <span>Review the full pipeline</span>
          <span class="hx-btn-arrow" aria-hidden="true"><svg viewBox="0 0 16 16"><path d="M3 8h10M9 4l4 4-4 4" /></svg></span>
        </a>
        <a href="/contact" class="hx-btn hx-btn--ghost">
          <span>Discuss a production package</span>
          <span class="hx-btn-arrow" aria-hidden="true"><svg viewBox="0 0 16 16"><path d="M3 8h10M9 4l4 4-4 4" /></svg></span>
        </a>
      </div>
    </div>

    <!-- RIGHT: sketch -> render reveal -->
    <figure class="hx-stage" id="hxStage" aria-label="A house shown first as a line drawing, then as a finished render">
      <div class="hx-frame">
        <video class="hx-render" id="hxVideo" muted playsinline preload="auto" poster="/images/hero/render.jpg" aria-hidden="true">
          <source src="/videos/hero-reveal.mp4" type="video/mp4" />
        </video>
        <img class="hx-lines" src="/images/hero/lines.jpg" alt="" aria-hidden="true" decoding="async" />
        <span class="hx-scan" aria-hidden="true"></span>
        <span class="hx-grid" aria-hidden="true"></span>

        <span class="hx-mark hx-mark--tl" aria-hidden="true"></span>
        <span class="hx-mark hx-mark--tr" aria-hidden="true"></span>
        <span class="hx-mark hx-mark--bl" aria-hidden="true"></span>
        <span class="hx-mark hx-mark--br" aria-hidden="true"></span>

        <figcaption class="hx-meta">
          <span class="hx-chip"><i aria-hidden="true"></i><b id="hxLabel">Elevation A · 1:100</b></span>
          <span class="hx-steps" aria-hidden="true">
            <span class="hx-step is-on" data-step="0">Sketch</span>
            <span class="hx-step-line"><span id="hxProgress"></span></span>
            <span class="hx-step" data-step="1">Render</span>
          </span>
        </figcaption>
        <span class="hx-coords" aria-hidden="true">33.68° N · 73.04° E</span>
        <span class="hx-hint" aria-hidden="true">Move across to compare</span>
      </div>
    </figure>
  </div>
</section>

<script>
  // Loop: (first time only) lines draw in -> hold -> scan sweeps to the render -> film plays
  // -> scan sweeps back to the drawing. Hovering lets the pointer control the split.
  const stage = document.getElementById("hxStage");
  const video = document.getElementById("hxVideo") as HTMLVideoElement | null;
  const label = document.getElementById("hxLabel");
  const progress = document.getElementById("hxProgress");

  if (stage && video && label && progress) {
    const reduce = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
    const steps = stage.querySelectorAll<HTMLElement>(".hx-step");
    const DRAW = 1600, HOLD = 1100, SWEEP = 2600, PLAY = 8500, BACK = 1400;
    const LOOP = HOLD + SWEEP + PLAY + BACK;
    const ease = (t: number) => (t < 0.5 ? 4 * t * t * t : 1 - Math.pow(-2 * t + 2, 3) / 2);

    let start = performance.now();
    let raf = 0;
    let scrub = false;
    let visible = true;
    let rendered = false;

    const setSplit = (p: number) => {
      stage.style.setProperty("--wipe", `${(p * 100).toFixed(2)}%`);
      progress.style.transform = `scaleX(${p})`;
      stage.classList.toggle("is-sweep", p > 0.002 && p < 0.998);
      const isRender = p > 0.5;
      if (isRender !== rendered) {
        rendered = isRender;
        label.textContent = isRender ? "Final render · 4K" : "Elevation A · 1:100";
        steps.forEach((s) => s.classList.toggle("is-on", (s.dataset.step === "1") === isRender));
      }
    };

    function frame(now: number) {
      raf = requestAnimationFrame(frame);
      if (scrub || !visible) return;
      let t = now - start;

      // first run: draw the lines in from black
      if (t < DRAW) {
        stage.style.setProperty("--draw", ease(t / DRAW).toFixed(3));
        setSplit(0);
        return;
      }
      stage.style.setProperty("--draw", "1");
      t = (t - DRAW) % LOOP;

      if (t < HOLD) {
        setSplit(0);
        if (!video.paused) video.pause();
        if (video.currentTime > 0.05) video.currentTime = 0;
      } else if ((t -= HOLD) < SWEEP) {
        setSplit(ease(t / SWEEP));
      } else if ((t -= SWEEP) < PLAY) {
        setSplit(1);
        if (video.paused) video.play().catch(() => {});
      } else {
        t -= PLAY;
        setSplit(1 - ease(t / BACK));
      }
    }

    if (reduce) {
      stage.style.setProperty("--draw", "1");
      setSplit(1);
    } else {
      stage.style.setProperty("--draw", "0");
      raf = requestAnimationFrame(frame);

      if (window.matchMedia("(hover: hover)").matches) {
        stage.addEventListener("pointerenter", () => {
          scrub = true;
          video.pause();
          stage.classList.add("is-scrub");
          stage.style.setProperty("--draw", "1");
        });
        stage.addEventListener("pointermove", (e) => {
          const r = stage.getBoundingClientRect();
          setSplit(Math.min(1, Math.max(0, (e.clientX - r.left) / r.width)));
        });
        stage.addEventListener("pointerleave", () => {
          scrub = false;
          stage.classList.remove("is-scrub");
          // carry on from the start of the sweep
          start = performance.now() - DRAW - HOLD;
        });
      }

      new IntersectionObserver(([e]) => {
        visible = e.isIntersecting;
        if (!visible) video.pause();
      }).observe(stage);

      document.addEventListener("visibilitychange", () => {
        if (document.hidden) { cancelAnimationFrame(raf); video.pause(); }
        else { start = performance.now() - DRAW; raf = requestAnimationFrame(frame); }
      });
    }
  }
</script>
