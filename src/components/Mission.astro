---
import "../styles/Mission.css";

// Booking month: up to the 15th we book the current month, after the 15th the next month.
// Worked out at build time and again in the visitor's browser, so it is never stale.
const MONTHS = ["January", "February", "March", "April", "May", "June", "July", "August", "September", "October", "November", "December"];
const bookingMonth = (d: Date) => MONTHS[(d.getMonth() + (d.getDate() > 15 ? 1 : 0)) % 12];
const days = [1, 2, 3, 4, 5, 6, 7];
const projectDots = Array.from({ length: 50 }, (_, i) => i);
---

<!-- STATS — each card leads with a visual; text is one short label. -->
<section class="mission" id="missionSection">
  <div class="mission-inner">
    <div class="mission-grid">

      <!-- COLUMN 1 -->
      <div class="mission-col">
        <!-- Partners: orbit of studio dots around the number -->
        <div class="mission-card m-partners" data-reveal>
          <div class="m-orbit" aria-hidden="true">
            <span class="m-ring m-ring--1"><i></i><i></i></span>
            <span class="m-ring m-ring--2"><i></i><i></i><i></i></span>
            <span class="m-ring m-ring--3"><i></i><i></i></span>
          </div>
          <div class="m-figure">
            <span class="m-num"><span data-count-to="40">40</span><sup>+</sup></span>
            <span class="m-label">Studio partners worldwide</span>
          </div>
        </div>

        <!-- Turnaround: seven day cells fill up to the first render -->
        <div class="mission-card m-days" data-reveal>
          <div class="m-figure m-figure--row">
            <span class="m-num"><span data-count-to="7">7</span><small>days</small></span>
            <span class="m-label">Brief to first render</span>
          </div>
          <ol class="m-day-track" aria-hidden="true">
            {days.map((d) => (
              <li style={`--i:${d}`} class:list={[d === 7 && "is-render"]}>
                <span>{d === 7 ? "" : `D${d}`}</span>
                {d === 7 && (
                  <svg viewBox="0 0 24 24"><path d="M4 5h16v14H4z M4 15l5-5 4 4 3-3 4 4" /></svg>
                )}
              </li>
            ))}
          </ol>
        </div>
      </div>

      <!-- COLUMN 2: featured — projects delivered -->
      <div class="mission-card m-projects" data-reveal>
        <!-- one dot per delivered project -->
        <div class="m-matrix" aria-hidden="true">
          {projectDots.map((i) => <span style={`--i:${i}`}></span>)}
        </div>
        <div class="m-projects-body">
          <span class="m-num m-num--xl"><span data-count-to="50">50</span><sup>+</sup></span>
          <span class="m-label">Projects delivered</span>
          <ul class="m-pills" aria-label="What you get">
            <li>
              <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 5h16v14H4z M4 15l5-5 4 4 3-3 4 4" /></svg>
              Renders
            </li>
            <li>
              <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M3 6h12v12H3z M15 10l6-3v10l-6-3" /></svg>
              Walkthroughs
            </li>
            <li>
              <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 4h7v7H4z M13 4h7v7h-7z M4 13h7v7H4z M13 13h7v7h-7z" /></svg>
              Stills
            </li>
          </ul>
          <span class="m-status"><i></i>Now booking for <b id="mBookingMonth">{bookingMonth(new Date())}</b></span>
        </div>
      </div>

      <!-- COLUMN 3: rating gauge + approval curve -->
      <div class="mission-card m-rating" data-reveal>
        <div class="m-gauge" aria-hidden="true">
          <svg viewBox="0 0 120 120">
            <defs>
              <linearGradient id="mGaugeGrad" x1="0" y1="0" x2="1" y2="1">
                <stop offset="0%" stop-color="#d9b48c" />
                <stop offset="100%" stop-color="#6b452c" />
              </linearGradient>
            </defs>
            <circle class="m-gauge-track" cx="60" cy="60" r="50" />
            <circle class="m-gauge-fill" cx="60" cy="60" r="50" pathLength="100" style="--val:96" />
          </svg>
          <div class="m-gauge-center">
            <span class="m-num"><span data-count-to="4.8" data-decimals="1">4.8</span><small>/5</small></span>
            <span class="m-stars">★★★★★</span>
          </div>
        </div>
        <span class="m-label m-label--center">Average client rating</span>

        <!-- a drawing sheet gets the client's approval stamp -->
        <div class="m-signoff">
          <div class="m-sheet" aria-hidden="true">
            <svg viewBox="0 0 160 100">
              <rect class="m-sheet-paper" x="1" y="1" width="158" height="98" rx="6" />
              <path class="m-sheet-draw" pathLength="100" d="M18 78 V44 L52 30 L86 44 V78 Z M86 56 H138 V78 H86 M52 30 V20 H64 V35 M30 78 V60 H44 V78 M60 50 H74 V62 H60 Z M98 62 H110 V72 H98 Z M118 62 H130 V72 H118 Z M10 78 H150" />
              <path class="m-sheet-dim" d="M18 88 H138 M18 85 V91 M138 85 V91" />
            </svg>
            <span class="m-stamp">Approved</span>
          </div>
          <span class="m-label">Faster client sign-off</span>
        </div>
      </div>

    </div>
  </div>
</section>

<script>
  const MONTHS = ["January", "February", "March", "April", "May", "June", "July", "August", "September", "October", "November", "December"];
  const now = new Date();
  const monthEl = document.getElementById("mBookingMonth");
  if (monthEl) monthEl.textContent = MONTHS[(now.getMonth() + (now.getDate() > 15 ? 1 : 0)) % 12];

  const section = document.getElementById("missionSection");
  if (section) {
    const revealEls = section.querySelectorAll<HTMLElement>("[data-reveal]");
    const countEls = section.querySelectorAll<HTMLElement>("[data-count-to]");
    const reduce = window.matchMedia("(prefers-reduced-motion: reduce)").matches;

    function animateCount(el: HTMLElement) {
      const target = parseFloat(el.dataset.countTo || "0");
      const decimals = parseInt(el.dataset.decimals || "0", 10);
      const duration = 1200;
      const start = performance.now();
      function tick(now: number) {
        const progress = Math.min((now - start) / duration, 1);
        const value = target * (1 - Math.pow(1 - progress, 3));
        el.textContent = decimals > 0 ? value.toFixed(decimals) : String(Math.round(value));
        if (progress < 1) requestAnimationFrame(tick);
      }
      requestAnimationFrame(tick);
    }

    const io = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry, i) => {
          if (!entry.isIntersecting) return;
          const el = entry.target as HTMLElement;
          window.setTimeout(() => el.classList.add("is-in"), i * 110);
          if (!reduce) el.querySelectorAll<HTMLElement>("[data-count-to]").forEach(animateCount);
          io.unobserve(el);
        });
      },
      { threshold: 0.25 }
    );
    revealEls.forEach((el) => io.observe(el));
    if (!("IntersectionObserver" in window)) countEls.forEach((el) => el.closest("[data-reveal]")?.classList.add("is-in"));
  }
</script>
