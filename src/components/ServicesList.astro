---
// SERVICES (home page): the original eight-service cards from the old Services page, brought back.
// Two columns of four. Every card rests small (number, thumbnail, name); hovering or focusing a card
// opens it: larger image, short description, what is included and a link to the service page.
// Only the heading, edges, corners and images were changed to match the proof section above.
import { services } from "../data/services";

// Photo for each service (Unsplash License, see public/images/CREDITS.md)
const media: Record<string, string> = {
  "bim-production": "/images/services/bim.jpg",
  "revit-production": "/images/services/revit.jpg",
  "mep-coordination": "/images/services/mep.jpg",
  "3d-modeling": "/images/services/modeling.jpg",
  "3ds-max-production": "/images/services/max.jpg",
  "architectural-visualization": "/images/services/archviz.jpg",
  "animation-motion": "/images/services/animation.jpg",
  "real-time": "/images/services/realtime.jpg",
};
// which part of each photo stays in view when the card is small
const focus: Record<string, string> = {
  "bim-production": "35% 50%",
  "revit-production": "45% 55%",
  "mep-coordination": "60% 45%",
  "3d-modeling": "40% 60%",
  "3ds-max-production": "45% 60%",
  "architectural-visualization": "60% 50%",
  "animation-motion": "30% 60%",
  "real-time": "78% 40%",
};
const columns = [services.slice(0, 4), services.slice(4)];
---

<section class="svl" id="services" aria-labelledby="svlTitle">
  <div class="svl-wrap">
    <header class="svl-head">
      <h2 class="svl-title" id="svlTitle">Eight services. <span>One production team.</span></h2>
      <p class="svl-lead">One team carries your project from the first model to the final film.</p>
    </header>

    <div class="svc-grid">
      {columns.map((col) => (
        <div class="svc-col">
          {col.map((s, idx) => (
            <article class="svc-card" data-reveal style={`--d:${idx * 0.08}s`} tabindex="0">
              <span class="svc-card-num">{s.num}</span>
              <div class="svc-card-media">
                <img src={media[s.slug]} alt={`${s.title}: ${s.includes.join(", ")}`} loading="lazy" decoding="async" style={`object-position:${focus[s.slug]}`} />
              </div>
              <div class="svc-card-body">
                <h3 class="svc-card-title">{s.title}</h3>
                <div class="svc-card-more">
                  <div class="svc-card-more-inner">
                    <p class="svc-card-blurb">{s.blurb}</p>
                    <p class="svc-card-tags">{s.includes.map((t) => <span>{t}</span>)}</p>
                    <a href={`/services/${s.slug}`} class="svc-card-link" aria-label={`Explore ${s.title}`}>
                      <span>Explore service</span>
                      <span aria-hidden="true">↗</span>
                    </a>
                  </div>
                </div>
              </div>
            </article>
          ))}
        </div>
      ))}
    </div>
  </div>
</section>

<style>
  /* edges and heading match the proof section above (6% sides, 1240px wide) */
  .svl { position: relative; padding: 40px 6% 100px; color: #fff; font-family: "Inter", system-ui, sans-serif; }
  .svl-wrap { max-width: 1240px; margin: 0 auto; }
  .svl-head { display: flex; flex-direction: column; gap: 14px; max-width: 980px; margin-bottom: 36px; }
  .svl-title { margin: 0; }
  .svl-title span { color: #8f6444; }
  .svl-lead { margin: 0; font-size: 17px; line-height: 1.6; color: #a49e9a; }

  /* ---------- original cards (from the old Services page) ---------- */
  .svc-grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 16px; align-items: start; }
  .svc-col { display: flex; flex-direction: column; gap: 12px; min-width: 0; }

  .svc-card {
    --m: clamp(150px, 15vw, 200px);
    position: relative;
    display: grid;
    grid-template-columns: clamp(40px, 4vw, 60px) var(--m) minmax(0, 1fr);
    align-items: center;
    gap: clamp(12px, 1.6vw, 24px);
    padding: clamp(18px, 2vw, 26px) clamp(16px, 2.2vw, 30px);
    background: #1b1b1b;
    border: 1px solid rgba(255, 255, 255, 0.1);
    border-radius: 20px;
    cursor: pointer;
    outline: none;
    transition: background-color 0.45s ease, border-color 0.35s ease, padding 0.45s ease;
  }
  .svc-card:hover { border-color: rgba(143, 100, 68, 0.5); }
  .svc-card:focus-visible { box-shadow: 0 0 0 2px #d9b48c; }

  .svc-card-num { font-size: clamp(22px, 2.2vw, 32px); font-weight: 500; letter-spacing: -0.02em; color: #5a5a5a; transition: color 0.35s ease; }
  .svc-card:is(:hover, :focus-within) .svc-card-num { color: #b8946f; }

  .svc-card-media {
    justify-self: center;
    width: var(--m);
    height: calc(var(--m) * 1.3333);
    border-radius: 10px;
    overflow: hidden;
    background: #0c0c0c;
    transition: width 0.5s cubic-bezier(0.16, 1, 0.3, 1), height 0.5s cubic-bezier(0.16, 1, 0.3, 1);
  }
  .svc-card-media img { width: 100%; height: 100%; object-fit: cover; display: block; }

  .svc-card-body { min-width: 0; display: flex; flex-direction: column; overflow-wrap: anywhere; }
  html body .svl h3.svc-card-title:not(#_):not(#_):not(#_) {
    margin: 0;
    font-size: clamp(20px, 1.8vw, 26px) !important;
    font-weight: 800;
    line-height: 1.15 !important;
    color: #ffffff;
    transition: font-size 0.45s ease;
  }

  .svc-card-more { display: grid; grid-template-rows: 1fr; opacity: 1; transition: grid-template-rows 0.5s cubic-bezier(0.16, 1, 0.3, 1), opacity 0.4s ease; }
  .svc-card-more-inner { min-height: 0; overflow: hidden; display: flex; flex-direction: column; align-items: flex-start; gap: 10px; }
  .svc-card-more-inner > :first-child { margin-top: 10px; }
  .svc-card-blurb { margin: 0; font-size: 13.5px; line-height: 1.55; color: #b4aeaa; }
  .svc-card-tags { margin: 0; display: flex; flex-wrap: wrap; gap: 4px 14px; font-size: 12px; color: #aea7a3; }
  .svc-card-link {
    display: inline-flex; align-items: center; gap: 8px; margin-top: 4px; padding: 9px 16px; border-radius: 999px;
    background: #5b3b27; color: #ffffff; text-decoration: none;
    font-size: 11px; font-weight: 700; letter-spacing: 0.08em; text-transform: uppercase;
    transition: background 0.3s ease;
  }
  .svc-card-link:hover, .svc-card-link:focus-visible { background: #6b452c; outline: none; }

  /* resting state: every card small */
  .svl.is-js .svc-card:not(:hover):not(:focus-within) { background: #0f0f0f; border-color: rgba(255, 255, 255, 0.08); padding-block: 16px; }
  .svl.is-js .svc-card:not(:hover):not(:focus-within) .svc-card-media { width: calc(var(--m) * 0.56); height: calc(var(--m) * 0.38); }
  html body .svl.is-js .svc-card:not(:hover):not(:focus-within) h3.svc-card-title:not(#_):not(#_):not(#_) { font-size: clamp(17px, 1.5vw, 21px) !important; }
  .svl.is-js .svc-card:not(:hover):not(:focus-within) .svc-card-more { grid-template-rows: 0fr; opacity: 0; }

  /* the card under the cursor (or keyboard focus) opens */
  .svl.is-js .svc-card:is(:hover, :focus-within) { background: #1b1b1b; border-color: rgba(143, 100, 68, 0.5); }

  /* reveal on scroll */
  .svl.is-js .svc-card[data-reveal] {
    opacity: 0; transform: translateY(18px);
    transition: opacity 0.7s ease var(--d, 0s), transform 0.7s cubic-bezier(0.22, 1, 0.36, 1) var(--d, 0s), background-color 0.45s ease, border-color 0.35s ease, padding 0.45s ease;
  }
  .svl.is-js .svc-card[data-reveal].is-visible { opacity: 1; transform: none; }

  @media (max-width: 900px) {
    .svc-grid { grid-template-columns: 1fr; gap: 12px; }
  }
  @media (max-width: 640px) {
    .svl { padding: 30px 16px 70px; }
    .svl-lead { font-size: 16px; }
  }
  @media (max-width: 560px) {
    .svc-card { --m: 108px; grid-template-columns: 28px var(--m) minmax(0, 1fr); gap: 12px; padding-inline: 14px; }
    .svc-card-num { font-size: 18px; }
  }
  @media (max-width: 400px) {
    .svc-card { --m: 92px; gap: 10px; padding-inline: 12px; }
    .svc-card-num { font-size: 16px; }
  }
  @media (prefers-reduced-motion: reduce) {
    .svc-card, .svc-card-media, .svc-card-more { transition: none !important; }
    .svl.is-js .svc-card[data-reveal] { opacity: 1 !important; transform: none !important; }
  }
</style>

<script>
  document.querySelectorAll<HTMLElement>(".svl").forEach((root) => {
    root.classList.add("is-js");
    const items = root.querySelectorAll<HTMLElement>("[data-reveal]");
    const io = new IntersectionObserver(
      (entries) => entries.forEach((e) => {
        if (e.isIntersecting) { e.target.classList.add("is-visible"); io.unobserve(e.target); }
      }),
      { threshold: 0.12 }
    );
    items.forEach((i) => io.observe(i));
    // touch screens: tapping a card opens it (focus), tapping the link goes to the service
  });
</script>
