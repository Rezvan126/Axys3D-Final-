---
// Virtual tours are part of the Work page now (/visuals/#tours). This address stays so old links keep
// working: it sends the visitor on at once, tells search engines the Work page is the real one, and is
// left out of the sitemap (astro.config.mjs). The single tour pages /tours/<slug>/ still exist as deep links.
const to = "/visuals/#tours";
const canonical = new URL("/visuals/", Astro.site ?? "https://axys3d.com").href;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Virtual tours | Axys3D</title>
    <meta name="robots" content="noindex, follow" />
    <link rel="canonical" href={canonical} />
    <meta http-equiv="refresh" content={`0; url=${to}`} />
  </head>
  <body>
    <p>Virtual tours are on our Work page. <a href={to}>Open the tours</a>.</p>
    <script is:inline define:vars={{ to }}>location.replace(to);</script>
  </body>
</html>
