---
// WORK: only the studio's own projects. One project shown in depth, then films from the portfolio.
import SEO from "../components/SEO.astro";
import Navbar from "../components/Navbar.astro";
import Footer from "../components/Footer.astro";
import WorkReel from "../components/WorkReel.astro";
import Tour from "../components/Tour.astro";
import { getTour, tours } from "../data/tours";
import { getCollection, getEntry } from "astro:content";
import { pic, posterOf } from "../data/media";
import "../styles/global.css";

// Everything on this page is edited in Pages CMS (see EDITING.md):
//   Work page words, opening film and featured tour  src/content/workPage/index.json
//   Projects, in their order, hidden ones left out    src/content/projects/<name>.json
const page = (await getEntry("workPage", "index"))!.data;
const heroPoster = page.heroPicture;

// the featured tour: the one chosen in the editor while its pictures are in place, otherwise the first ready tour
const featured = (page.featuredTour ? getTour(page.featuredTour) : undefined) ?? tours[0];

const projects = (await getCollection("projects"))
  .map((p) => p.data)
  .filter((p) => p.visible && p.gallery.length > 0)
  .sort((a, b) => a.order - b.order || a.title.localeCompare(b.title))
  .map((p, k) => ({
    ...p,
    // the first project keeps the anchor "#project" that the opening links to
    id: k === 0 ? "project" : `project-${k + 1}`,
    head: k === 0 ? "vsProject" : `vsProject${k + 1}`,
    pics: p.gallery.map((g) => ({ ...pic(g.image, g), alt: g.alt })),
    stages: p.drawings.map((d) => ({ ...pic(d.image, undefined, { w: 1600, h: 1000 }), title: d.title, text: d.text, alt: d.alt })),
    reel: p.films.map((f) => ({ ...f, film: f.film ?? f.clip, cover: pic(f.poster ?? posterOf(f.clip), undefined, { w: 1600, h: 900 }) })),
    tourLink: p.tour && featured?.slug === p.tour ? "#tour" : p.tour && getTour(p.tour) ? `/tours/${p.tour}/` : "",
  }));
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <SEO title={page.seoTitle} description={page.seoDescription} image="/media/adu-1.webp" />
  </head>

  <body>
    <Navbar />
    <main id="main" tabindex="-1" class="pg">
      <section class="pg-hero">
        <div class="ax-wrap">
          <h1 class="ax-display ax-h1--sm" data-ax>{page.heading}</h1>
          {page.lead && <p class="ax-lead" data-ax>{page.lead}</p>}
          <div class="pg-actions" data-ax>
            <a href="/contact/" class="ax-btn ax-btn--gold">Start a project</a>
            {projects.length > 0 && <a href="#project" class="ax-link">See one project start to finish</a>}
          </div>
        </div>
        <figure class="ax-wrap pg-hero-media" data-ax>
          {page.heroFilm
            ? <video muted playsinline loop autoplay preload="metadata" poster={heroPoster} src={page.heroFilm} aria-label={page.heroFilmLabel}></video>
            : <img src={heroPoster} alt={page.heroFilmLabel} decoding="async" />}
        </figure>
      </section>

      <!-- one featured tour from the library (/tours/). Loads nothing until "Start the tour" is pressed -->
      {featured && (
        <Tour
          slug={featured.slug}
          heading={page.tourHeading}
          lead={featured.slug === page.featuredTour && page.tourLead ? page.tourLead : featured.summary}
          links={[{ href: "/tours/", label: "See all tours" }, { href: "/services/real-time/", label: "Interactive tours and showrooms" }]}
        />
      )}

      {projects.map((p, k) => (
        <section class:list={[k > 0 && "ax-section"]} aria-labelledby={p.head} id={p.id}>
          <div class="ax-wrap">
            <header class="ax-head">
              <h2 class="ax-display" id={p.head} data-ax>{p.title}</h2>
              {p.summary && <p class="ax-lead" data-ax>{p.summary}</p>}
              {p.tour || p.links.length > 1 ? (
                <div class="vs-links" data-ax>{p.links.map((l) => <a class="ax-link" href={l.href}>{l.label}</a>)}{p.tourLink && <a class="ax-link" href={p.tourLink}>Walk through the rooms</a>}</div>
              ) : p.links.map((l) => <a class="ax-link" href={l.href} data-ax>{l.label}</a>)}
            </header>
            <ul class="pg-gallery">
              {p.pics.map((r, i) => (
                <li class:list={[i === 0 && "wide"]} data-ax style={`--ax-d:${(i % 3) * 0.06}s`}>
                  <button type="button" class="vs-zoom" data-full={r.src} aria-label={`Open ${p.pictureName} ${i + 1} large`}><img src={r.src} srcset={r.srcset} sizes={i === 0 ? "(max-width: 900px) 94vw, 820px" : "(max-width: 900px) 46vw, 400px"} width={r.w} height={r.h} alt={r.alt} loading={k === 0 && i === 0 ? "eager" : "lazy"} decoding="async" /></button>
                </li>
              ))}
            </ul>
            {p.stages.length > 0 && (
              <ol class="vs-stages">
                {p.stages.map((s, i) => (
                  <li data-ax style={`--ax-d:${i * 0.07}s`}>
                    <button type="button" class="vs-zoom" data-full={s.src} aria-label={`Open the ${s.title.toLowerCase()} large`}><img src={s.src} srcset={s.srcset} sizes="(max-width: 900px) 94vw, 400px" width={s.w} height={s.h} alt={s.alt} loading="lazy" decoding="async" /><span class="vs-zoom-i" aria-hidden="true"><svg viewBox="0 0 16 16" width="16" height="16" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"><path d="M10 2h4v4M6 14H2v-4M14 2L9.5 6.5M2 14l4.5-4.5" /></svg></span></button>
                    <h3>{s.title}</h3>
                    <p>{s.text}</p>
                  </li>
                ))}
              </ol>
            )}
            {p.reel.length > 0 && (
              <ul class="wr-grid vs-reel">
                {p.reel.map((w) => (
                  <li class="wr-item" data-ax>
                    <button type="button" class="wr-tile" data-clip={w.clip} data-film={w.film} data-title={w.title} aria-label={`Play film: ${w.title}`}>
                      <img src={w.cover.src} srcset={w.cover.srcset} sizes="(max-width: 760px) 94vw, 610px" width={w.cover.w} height={w.cover.h} alt="" loading="lazy" decoding="async" />
                      <video muted loop playsinline preload="none" aria-hidden="true" tabindex="-1"></video>
                      <span class="wr-cap"><strong>{w.title}</strong>{w.kind && <span>{w.kind}</span>}</span>
                      <span class="wr-play" aria-hidden="true"><svg viewBox="0 0 24 24"><path d="M8 5.5v13l11-6.5z" /></svg></span>
                    </button>
                  </li>
                ))}
              </ul>
            )}
          </div>
        </section>
      ))}

      <section class="ax-section vs-films" aria-labelledby="vsFilms" id="films">
        <div class="ax-wrap">
          <header class="ax-head" style="margin-bottom:0">
            <h2 class="ax-display" id="vsFilms" data-ax>{page.filmsHeading}</h2>
            {page.filmsLead && <p class="ax-lead" data-ax>{page.filmsLead}</p>}
          </header>
        </div>
        <WorkReel limit={page.filmsCount} heading={false} feature={true} />
      </section>

      <section class="pg-cta ax-dark">
        <div class="ax-wrap">
          <h2 class="ax-display" data-ax>{page.closingHeading}</h2>
          {page.closingLead && <p class="ax-lead" data-ax>{page.closingLead}</p>}
          <div class="pg-actions" data-ax><a href="/contact/" class="ax-btn ax-btn--gold">Start a project</a></div>
        </div>
      </section>
    </main>
    <dialog class="vs-box ax-dark" id="vsBox" aria-label="Large view">
      <button type="button" class="vs-box-x" aria-label="Close"><svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path d="M6 6l12 12M18 6L6 18" /></svg></button>
      <button type="button" class="vs-box-nav vs-box-prev" aria-label="Previous picture"><svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M15 5l-7 7 7 7" /></svg></button>
      <img alt="" />
      <button type="button" class="vs-box-nav vs-box-next" aria-label="Next picture"><svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M9 5l7 7-7 7" /></svg></button>
      <p class="vs-box-cap" aria-live="polite"></p>
    </dialog>
    <Footer />
  </body>
</html>

<style is:global>
  .vs-links { display: flex; flex-wrap: wrap; gap: 8px 24px; }
  .vs-zoom { position: relative; display: block; width: 100%; height: 100%; padding: 0; border: 0; background: none; cursor: zoom-in; border-radius: inherit; overflow: hidden; }
  .vs-zoom img { transition: transform 1.2s var(--ax-ease); }
  .vs-zoom:hover img { transform: scale(1.04); }
  .vs-stages .vs-zoom { height: auto; border-radius: var(--ax-r-md); }
  .vs-zoom-i { position: absolute; right: 10px; top: 10px; display: grid; place-items: center; width: 32px; height: 32px; border-radius: var(--ax-r-chip); background: rgba(14, 16, 20, 0.7); color: #fff; }
  .vs-box { width: 100vw; height: 100dvh; max-width: none; max-height: none; margin: 0; padding: clamp(12px, 3vw, 40px); border: 0; background: rgba(8, 9, 11, 0.94); }
  .vs-box[open] { display: grid; place-items: center; }
  .vs-box::backdrop { background: rgba(8, 9, 11, 0.6); }
  .vs-box img { max-width: 100%; max-height: 100%; width: auto; height: auto; object-fit: contain; border-radius: var(--ax-r-media); }
  .vs-box-x { position: absolute; right: clamp(10px, 2vw, 24px); top: clamp(10px, 2vw, 24px); z-index: 1; display: grid; place-items: center; width: 48px; height: 48px; border-radius: var(--ax-r-btn-sm); background: rgba(255, 255, 255, 0.14); color: #fff; }
  .vs-box-x:hover { background: rgba(255, 255, 255, 0.26); }
  .vs-box-nav { position: absolute; top: 50%; z-index: 1; display: grid; place-items: center; width: 48px; height: 48px; margin-top: -24px; border-radius: var(--ax-r-btn-sm); background: rgba(14, 16, 20, 0.7); color: #fff; }
  .vs-box-nav:hover { background: rgba(255, 255, 255, 0.26); }
  .vs-box-prev { left: clamp(8px, 2vw, 24px); } .vs-box-next { right: clamp(8px, 2vw, 24px); }
  .vs-box-cap { position: absolute; left: 0; right: 0; bottom: clamp(10px, 2vw, 22px); margin: 0; text-align: center; font-size: 14px; font-weight: 600; color: rgba(255, 255, 255, 0.8); }
  .vs-stages { list-style: none; margin: clamp(28px, 4vw, 56px) 0 0; padding: 0; display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: clamp(16px, 2.4vw, 32px); }
  .vs-stages img { display: block; width: 100%; height: auto; aspect-ratio: 16 / 10; object-fit: cover; border-radius: var(--ax-r-md); background: #0d0d0c; }
  .vs-stages h3 { margin: 18px 0 8px; }
  .vs-stages p { margin: 0; font-size: 15.5px; line-height: 1.55; color: var(--ax-text-2); }
  .tour ~ #project { padding-top: var(--ax-section); }   /* the project used to lean on the opening's bottom space; the tour now sits between */
  .vs-films .wr { padding-top: clamp(32px, 4vw, 56px); padding-bottom: 0; }
  @media (max-width: 1000px) { .vs-stages { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
  @media (max-width: 560px) { .vs-stages { grid-template-columns: 1fr; } }
</style>

<script>
  const box = document.getElementById("vsBox") as HTMLDialogElement | null;
  if (box) {
    const img = box.querySelector("img")!;
    const cap = box.querySelector<HTMLElement>(".vs-box-cap")!;
    const items = Array.from(document.querySelectorAll<HTMLButtonElement>(".vs-zoom"));
    let at = 0;
    const show = (i: number) => {
      at = (i + items.length) % items.length;
      const b = items[at];
      img.src = b.dataset.full!;
      img.alt = b.querySelector("img")?.alt ?? "";
      cap.textContent = `${at + 1} of ${items.length}`;
    };
    items.forEach((b, i) => b.addEventListener("click", () => { show(i); box.showModal(); }));
    box.querySelector(".vs-box-x")!.addEventListener("click", () => box.close());
    box.querySelector(".vs-box-prev")!.addEventListener("click", () => show(at - 1));
    box.querySelector(".vs-box-next")!.addEventListener("click", () => show(at + 1));
    box.addEventListener("click", (e) => { if (e.target === box) box.close(); });
    box.addEventListener("keydown", (e) => { if (e.key === "ArrowRight") show(at + 1); if (e.key === "ArrowLeft") show(at - 1); });
    box.addEventListener("close", () => items[at]?.focus({ preventScroll: true }));
  }
</script>
