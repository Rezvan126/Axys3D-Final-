
---
import SEO from "../components/SEO.astro";
import Navbar from "../components/Navbar.astro";
import Footer from "../components/Footer.astro";
import MotionReveal from "../components/MotionReveal.astro";
import "../styles/token.css";
import "../styles/global.css";
import "../styles/Navbar.css";
import "../styles/footer.css";
import { getCollection } from "astro:content";

// Fetch Master Insights Page Header Content
const insightsPageEntries = await getCollection("insightsPage");
const pageData = insightsPageEntries[0]?.data || {
  heroTitle: "Insights / Technical production",
  heroSubtitle: "Practical notes for controlled AEC delivery.",
  heroDescription:
    "Fictional development articles demonstrate the editorial structure. They are not client evidence, legal advice or published thought leadership.",
};

// Articles (newest first) and case studies, shown together with filters
const articleEntries = (await getCollection("insights")).sort(
  (a, b) => (b.data.publishDate?.getTime() ?? 0) - (a.data.publishDate?.getTime() ?? 0)
);
const caseEntries = await getCollection("projects");

// Local images only (no stock photos)
const fallbackImages = [
  "/images/gallery/exterior-1.jpg",
  "/images/gallery/interior-1.jpg",
  "/images/gallery/video3.jpg",
  "/images/gallery/video2.jpg",
  "/images/gallery/landscape.jpg",
];
const fmtDate = (d?: Date) => (d ? d.toLocaleDateString("en-US", { month: "short", day: "numeric", year: "numeric" }) : "");

type Item = { kind: "article" | "case"; href: string; title: string; summary: string; meta: string; badge: string; cta: string; image: string; alt: string; category: string; date?: Date };
const items: Item[] = [
  ...articleEntries.map((a, i) => ({
    kind: "article" as const,
    href: `/insights/${a.id}/`,
    title: a.data.title,
    summary: a.data.summary,
    meta: `${a.data.category} · ${a.data.readTime} read`,
    badge: a.data.badgeText,
    cta: a.data.ctaLabel,
    image: a.data.image ?? fallbackImages[i % fallbackImages.length],
    alt: a.data.imageAlt ?? "",
    category: a.data.category,
    date: a.data.publishDate,
  })),
  ...caseEntries.map((c, i) => ({
    kind: "case" as const,
    href: `/work/${c.id}/`,
    title: c.data.title,
    summary: c.data.summary,
    meta: `${c.data.sector} · ${c.data.projectStage}`,
    badge: "Case study",
    cta: "View case study",
    image: c.data.coverImage ?? fallbackImages[(i + 2) % fallbackImages.length],
    alt: "",
    category: "Case study",
    date: c.data.publishDate,
  })),
];
const categories = [...new Set(articleEntries.map((a) => a.data.category))];

// Structured data: a listing page of articles and case studies
const listLd = {
  "@context": "https://schema.org",
  "@type": "CollectionPage",
  name: "Axys3D Insights & case studies",
  description: pageData.heroDescription,
  mainEntity: {
    "@type": "ItemList",
    itemListElement: items.map((it, i) => ({ "@type": "ListItem", position: i + 1, url: it.href, name: it.title })),
  },
};

const featured = items.find((it) => it.kind === "article");
const rest = items.filter((it) => it !== featured);
const nGuides = items.filter((it) => it.kind === "article").length;
const nCases = items.filter((it) => it.kind === "case").length;
const badgeLabel = (it: Item) => (it.kind === "case" ? "Case study" : "Guide");
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <SEO
      title="Insights: BIM, Revit & Architectural Visualization Guides | Axys3D"
      description="Practical guides on BIM, Revit documentation and model coordination, and case studies showing how a brief becomes a delivered package."
      jsonLd={listLd}
    />
  </head>

  <body class="page-insights-list">
    <Navbar variant="solid" />

    <main id="main" tabindex="-1" class="ins">
      <!-- HERO -->
      <section class="ins-hero">
        <div class="ins-wrap" data-motion-group>
          <span class="ins-eyebrow" data-motion>Insights</span>
          <h1 data-motion>Articles and case studies.</h1>
          <p class="ins-lead" data-motion>Practical guides on BIM, Revit documentation and model coordination, and case studies that show how a brief becomes a delivered package.</p>
          <ul class="ins-count" data-motion>
            <li><b>{nGuides}</b> guides</li>
            <li><b>{nCases}</b> case studies</li>
          </ul>
        </div>
      </section>

      <!-- FEATURED -->
      {featured && (
        <section class="ins-sec ins-sec--tight" aria-label="Featured guide">
          <div class="ins-wrap" data-motion-group>
            <a data-motion class="ins-feature" href={featured.href}>
              <div class="ins-feature-media"><img src={featured.image} alt={featured.alt} loading="eager" decoding="async" /></div>
              <div class="ins-feature-body">
                <span class="ins-badge">Latest guide</span>
                <span class="ins-meta">{featured.meta}{featured.date && <> · {fmtDate(featured.date)}</>}</span>
                <h2>{featured.title}</h2>
                <p>{featured.summary}</p>
                <span class="ins-more">Read the guide <svg viewBox="0 0 16 16" aria-hidden="true"><path d="M3 8h10M9 4l4 4-4 4" /></svg></span>
              </div>
            </a>
          </div>
        </section>
      )}

      <!-- ALL POSTS -->
      <section class="ins-sec" aria-labelledby="insAll">
        <div class="ins-wrap">
          <header class="ins-head" data-motion-group>
            <h2 data-motion id="insAll">Everything <span>we have published.</span></h2>
          </header>
          <div class="ins-filters" role="group" aria-label="Filter posts">
            <button type="button" class="is-on" data-filter="all" aria-pressed="true">All</button>
            <button type="button" data-filter="article" aria-pressed="false">Guides</button>
            <button type="button" data-filter="case" aria-pressed="false">Case studies</button>
            <span class="ins-filters-sep" aria-hidden="true"></span>
            {categories.map((c) => <button type="button" data-filter={`cat:${c}`} aria-pressed="false">{c}</button>)}
          </div>
          <ul class="ins-grid" data-motion-group>
            {rest.map((it) => (
              <li data-kind={it.kind} data-cat={it.category} data-motion>
                <a class="ins-card" href={it.href}>
                  <div class="ins-card-media"><img src={it.image} alt={it.alt} loading="lazy" decoding="async" /></div>
                  <div class="ins-card-body">
                    <div class="ins-card-top">
                      <span class:list={["ins-badge", it.kind === "case" && "ins-badge--case"]}>{badgeLabel(it)}</span>
                      {it.date && <span class="ins-date">{fmtDate(it.date)}</span>}
                    </div>
                    <span class="ins-meta">{it.meta}</span>
                    <h3>{it.title}</h3>
                    <p>{it.summary}</p>
                    <span class="ins-more">{it.kind === "case" ? "View case study" : "Read the guide"} <svg viewBox="0 0 16 16" aria-hidden="true"><path d="M3 8h10M9 4l4 4-4 4" /></svg></span>
                  </div>
                </a>
              </li>
            ))}
          </ul>
          <p class="ins-empty" hidden>Nothing here yet in this topic.</p>
        </div>
      </section>

      <!-- CLOSING CTA -->
      <section class="ins-cta">
        <div class="ins-wrap ins-cta-in" data-motion-group>
          <h2 data-motion>Have a project in mind? <span>Send us your brief.</span></h2>
          <p data-motion>Share your drawings and deadline. We reply with a clear scope, price and timeline.</p>
          <a href="/contact/" class="ins-cta-btn" data-motion>Start a project <svg viewBox="0 0 16 16" aria-hidden="true"><path d="M3 8h10M9 4l4 4-4 4" /></svg></a>
        </div>
      </section>
    </main>

    <Footer />
    <MotionReveal />

    <script>
      import { animate, stagger } from "motion";
      const reduceMotion = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
      const buttons = Array.from(document.querySelectorAll<HTMLButtonElement>(".ins-filters button"));
      const posts = Array.from(document.querySelectorAll<HTMLElement>(".ins-grid > li"));
      const empty = document.querySelector<HTMLElement>(".ins-empty");
      buttons.forEach((b) =>
        b.addEventListener("click", () => {
          const f = b.dataset.filter || "all";
          buttons.forEach((x) => { x.classList.toggle("is-on", x === b); x.setAttribute("aria-pressed", String(x === b)); });
          let shown = 0;
          posts.forEach((p) => {
            const ok = f === "all" || p.dataset.kind === f || (f.startsWith("cat:") && p.dataset.cat === f.slice(4));
            p.hidden = !ok;
            if (ok) shown++;
          });
          if (empty) empty.hidden = shown > 0;
          const visible = posts.filter((p) => !p.hidden);
          if (!reduceMotion && visible.length) animate(visible, { opacity: [0, 1], y: [12, 0] }, { duration: 0.35, ease: [0.22, 1, 0.36, 1], delay: stagger(0.05) });
        })
      );
    </script>
  </body>
</html>

<style>
  .ins { color: #fff; font-family: "Barlow", system-ui, sans-serif; background: #050506; }
  .ins-wrap { width: min(100% - 12%, 1240px); margin: 0 auto; }

  .ins-hero { padding: 170px 0 60px; background: radial-gradient(circle at 78% 30%, rgba(143, 100, 68, 0.22) 0%, rgba(91, 59, 39, 0.08) 30%, transparent 58%), #050506; }
  .ins-eyebrow { display: block; margin-bottom: 18px; font-size: 12px; font-weight: 600; letter-spacing: 0.18em; text-transform: uppercase; color: #b8946f; }
  .ins-hero h1 { margin: 0; }
  .ins-lead { margin: 22px 0 0; max-width: 760px; font-size: 18px; line-height: 1.6; color: #c4bab1; }
  .ins-count { list-style: none; margin: 30px 0 0; padding: 0; display: flex; flex-wrap: wrap; gap: 12px; }
  .ins-count li { padding: 12px 18px; border-radius: 14px; border: 1px solid rgba(255, 255, 255, 0.1); background: rgba(255, 255, 255, 0.03); font-size: 15px; color: #a49e9a; }
  .ins-count b { color: #fff; font-weight: 600; font-size: 17px; margin-right: 4px; }

  .ins-sec { padding: 40px 0 90px; }
  .ins-sec--tight { padding-bottom: 40px; }
  .ins-head { margin-bottom: 22px; }
  .ins-head h2 { margin: 0; }
  .ins-head h2 span { color: #8f6444; }

  .ins-badge { align-self: flex-start; display: inline-flex; align-items: center; padding: 6px 11px; border-radius: 999px; font-size: 12px; font-weight: 600; letter-spacing: 0.08em; text-transform: uppercase; color: #1a120c; background: #d9b48c; }
  .ins-badge--case { color: #e3c8a8; background: transparent; border: 1px solid rgba(217, 180, 140, 0.55); }
  .ins-meta { font-size: 13px; font-weight: 600; letter-spacing: 0.06em; text-transform: uppercase; color: #b8946f; }
  .ins-date { font-size: 13px; color: #8f8984; }
  .ins-more { margin-top: auto; padding-top: 8px; display: inline-flex; align-items: center; gap: 8px; font-size: 14.5px; font-weight: 600; color: #d9b48c; }
  .ins-more svg { width: 14px; height: 14px; fill: none; stroke: currentColor; stroke-width: 1.8; stroke-linecap: round; stroke-linejoin: round; transition: transform 0.2s ease; }

  /* featured guide: image left, text right */
  .ins-feature { display: grid; grid-template-columns: minmax(0, 1.15fr) minmax(0, 1fr); border-radius: 24px; overflow: hidden; background: #121010; border: 1px solid rgba(255, 255, 255, 0.09); text-decoration: none; color: inherit; transition: border-color 0.3s ease; }
  .ins-feature:hover { border-color: rgba(143, 100, 68, 0.45); }
  .ins-feature-media { min-height: 360px; overflow: hidden; background: #0b0a0a; }
  .ins-feature-media img { width: 100%; height: 100%; object-fit: cover; display: block; transition: transform 0.6s cubic-bezier(0.22, 1, 0.36, 1); }
  .ins-feature:hover .ins-feature-media img { transform: scale(1.03); }
  .ins-feature-body { display: flex; flex-direction: column; gap: 12px; padding: 36px 36px 34px; }
  .ins-feature-body h2 { margin: 4px 0 0; }
  .ins-feature-body p { margin: 0; font-size: 16px; line-height: 1.6; color: #c4bab1; }
  .ins-feature:hover .ins-more svg, .ins-card:hover .ins-more svg { transform: translateX(3px); }

  /* filters */
  .ins-filters { display: flex; flex-wrap: wrap; align-items: center; gap: 8px; margin-bottom: 26px; }
  .ins-filters button {
    min-height: 44px; padding: 0 16px; border-radius: 999px; cursor: pointer;
    border: 1px solid rgba(255, 255, 255, 0.14); background: rgba(255, 255, 255, 0.03); color: #d6cfc8;
    font: 600 14px/1 "Barlow", system-ui, sans-serif; transition: border-color 0.2s ease, background 0.2s ease, color 0.2s ease;
  }
  .ins-filters button:hover { border-color: rgba(184, 148, 111, 0.6); color: #fff; }
  .ins-filters button.is-on { background: #5b3b27; border-color: #8f6444; color: #fff; }
  .ins-filters-sep { width: 1px; height: 26px; margin: 0 6px; background: rgba(255, 255, 255, 0.14); }

  /* grid: image on top, text below */
  .ins-grid { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 20px; }
  .ins-grid > li[hidden] { display: none; }
  .ins-card { display: flex; flex-direction: column; height: 100%; border-radius: 22px; overflow: hidden; background: #121010; border: 1px solid rgba(255, 255, 255, 0.09); text-decoration: none; color: inherit; transition: border-color 0.3s ease; }
  .ins-card:hover { border-color: rgba(143, 100, 68, 0.45); }
  .ins-card-media { aspect-ratio: 16 / 10; overflow: hidden; background: #0b0a0a; }
  .ins-card-media img { width: 100%; height: 100%; object-fit: cover; display: block; transition: transform 0.6s cubic-bezier(0.22, 1, 0.36, 1); }
  .ins-card:hover .ins-card-media img { transform: scale(1.04); }
  .ins-card-body { display: flex; flex-direction: column; gap: 10px; flex: 1; padding: 22px 24px 24px; border-top: 1px solid rgba(255, 255, 255, 0.07); }
  .ins-card-top { display: flex; align-items: center; justify-content: space-between; gap: 10px; }
  .ins-card h3 { margin: 2px 0 0; }
  .ins-card p { margin: 0; font-size: 15px; line-height: 1.55; color: #b9b2ac; display: -webkit-box; -webkit-line-clamp: 3; -webkit-box-orient: vertical; overflow: hidden; }
  .ins-empty { margin: 20px 0 0; color: #a49e9a; }

  /* closing call to action */
  .ins-cta { padding: 60px 0 130px; text-align: center; background: radial-gradient(50% 70% at 50% 60%, rgba(143, 100, 68, 0.16), transparent 70%), #050506; }
  .ins-cta-in { display: flex; flex-direction: column; align-items: center; gap: 18px; }
  .ins-cta h2 { margin: 0; max-width: 820px; }
  .ins-cta h2 span { display: block; color: #8f6444; }
  .ins-cta p { margin: 0; max-width: 520px; font-size: 17px; line-height: 1.6; color: #a49e9a; }
  .ins-cta-btn {
    margin-top: 8px; display: inline-flex; align-items: center; gap: 12px; min-height: 48px; padding: 0 26px; border-radius: 999px;
    background: #5b3b27; border: 1px solid #8f6444; color: #fff; font-size: 15px; font-weight: 600; text-decoration: none;
    transition: background 0.25s ease, transform 0.25s ease;
  }
  .ins-cta-btn svg { width: 15px; height: 15px; fill: none; stroke: currentColor; stroke-width: 1.8; stroke-linecap: round; stroke-linejoin: round; }
  .ins-cta-btn:hover { background: #6b452c; transform: translateY(-1px); }

  @media (max-width: 1000px) {
    .ins-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    .ins-feature { grid-template-columns: 1fr; }
    .ins-feature-media { min-height: 0; aspect-ratio: 16 / 9; }
  }
  @media (max-width: 760px) {
    .ins-wrap { width: min(100% - 32px, 100%); }
    .ins-hero { padding: 130px 0 40px; }
    .ins-lead { font-size: 16.5px; }
    .ins-sec { padding: 24px 0 64px; }
    .ins-grid { grid-template-columns: 1fr; }
    .ins-feature-body { padding: 24px 22px; }
    .ins-filters-sep { display: none; }
  }
  @media (prefers-reduced-motion: reduce) {
    .ins-card-media img, .ins-feature-media img, .ins-more svg { transition: none; }
  }
</style>
