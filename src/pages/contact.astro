---
import SEO from "../components/SEO.astro";
import Navbar from "../components/Navbar.astro";
import Footer from "../components/Footer.astro";
import "../styles/global.css";
import { services } from "../data/services";
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <SEO title="Start a Project | Axys3D" description="Send Axys3D your drawings and deadline. We reply within one working day with a clear scope, price and timeline." />
  </head>

  <body>
    <Navbar />
    <main id="main" tabindex="-1" class="pg">
      <section class="pg-hero ct">
        <div class="ax-wrap ct-grid">
          <div class="ct-copy">
            <h1 class="ax-display ax-h1--sm">Tell us what you are building.</h1>
            <p class="ax-lead">Four fields are enough to start. We reply within one working day with a clear scope, price and timeline.</p>
            <ol class="ct-next" aria-label="What happens next">
              <li><b>1</b><span>We read your brief and reply within one working day.</span></li>
              <li><b>2</b><span>You get a fixed scope, price and timeline to approve.</span></li>
              <li><b>3</b><span>Work starts only after you say yes.</span></li>
            </ol>
            <ul class="ct-points pg-ticks">
              <li>NDA signed before you share any files</li>
              <li>Built in your templates and standards</li>
              <li>Checked in house before it reaches you</li>
            </ul>
            <p class="ct-mail">Prefer email? <a href="mailto:info@axys3d.com">info@axys3d.com</a></p>
          </div>

          <form class="ax-form ct-form" id="contact-form" action="/mail/contact-handler.php" method="POST" novalidate>
            <div class="ax-hp" aria-hidden="true"><label for="website">Website</label><input type="text" id="website" name="website" tabindex="-1" autocomplete="off" /></div>

            <div class="ax-field">
              <label for="name">Your name</label>
              <input type="text" id="name" name="name" autocomplete="name" required />
            </div>
            <div class="ax-field">
              <label for="workEmail">Work email</label>
              <input type="email" id="workEmail" name="workEmail" autocomplete="email" inputmode="email" required />
            </div>
            <div class="ax-field">
              <label for="projectType">What do you need?</label>
              <select id="projectType" name="projectType" required>
                <option value="" disabled selected>Choose a service</option>
                {services.map((s) => <option value={s.title}>{s.title}</option>)}
                <option value="Not sure yet">Not sure yet</option>
              </select>
            </div>
            <div class="ax-field">
              <label for="company">Company <small>(optional)</small></label>
              <input type="text" id="company" name="company" autocomplete="organization" />
            </div>
            <div class="ax-field ax-field--full">
              <label for="projectBrief">About the project</label>
              <textarea id="projectBrief" name="projectBrief" rows="5" placeholder="What is the building, what do you have so far, and what do you need back?" required></textarea>
            </div>
            <div class="ax-field">
              <label for="targetDate">Deadline <small>(optional)</small></label>
              <input type="date" id="targetDate" name="targetDate" />
            </div>
            <div class="ax-field">
              <label for="additionalInformation">Link to your files <small>(optional)</small></label>
              <input type="url" id="additionalInformation" name="additionalInformation" placeholder="Drive or Dropbox link" inputmode="url" />
            </div>

            <p class="ax-form-msg" id="ct-msg" role="alert"></p>
            <label class="ct-nda ax-field--full"><input type="checkbox" id="ndaFirst" /><span>Send me an NDA to sign before I share files</span></label>
            <div class="ax-form-foot">
              <button type="submit" class="ax-btn ax-btn--gold" id="ct-submit">Send brief</button>
              <p class="ax-form-note">We only use your details to reply to this enquiry. Design authority and professional sign off stay with your appointed professionals.</p>
            </div>
          </form>
        </div>
      </section>
    </main>
    <Footer />

    <script>
      const form = document.getElementById("contact-form") as HTMLFormElement | null;
      // arriving from a service page: that service is already chosen
      try {
        const want = sessionStorage.getItem("ax-service");
        const sel = document.getElementById("projectType") as HTMLSelectElement | null;
        if (want && sel) { const o = Array.from(sel.options).find((x) => x.value === want); if (o) sel.value = o.value; sessionStorage.removeItem("ax-service"); }
      } catch {}
      const btn = document.getElementById("ct-submit") as HTMLButtonElement | null;
      const msg = document.getElementById("ct-msg");
      form?.addEventListener("submit", async (e) => {
        e.preventDefault();
        if (!form || !btn || !msg) return;
        msg.textContent = "";
        // check the fields ourselves so the message is clear and focus lands on the first problem
        const bad = Array.from(form.querySelectorAll<HTMLInputElement>("[required]")).find((f) => !f.checkValidity());
        if (bad) {
          msg.textContent = bad.type === "email" && bad.value ? "Please enter a valid email address." : "Please fill in your name, email, what you need and a few words about the project.";
          bad.focus();
          return;
        }
        btn.disabled = true; btn.textContent = "Sending";
        // who the visitor is (from the home page picker) and an NDA request travel inside the brief text,
        // so the mail handler needs no change
        const data = new FormData(form);
        const notes: string[] = [];
        try { const who = localStorage.getItem("ax-who"); if (who) notes.push(`Client type: ${who}`); } catch {}
        if ((document.getElementById("ndaFirst") as HTMLInputElement | null)?.checked) notes.push("NDA requested before files are shared");
        if (notes.length) data.set("projectBrief", `${data.get("projectBrief")}\n\n[${notes.join("] [")}]`);
        try {
          const res = await fetch(form.action, { method: "POST", body: data });
          const out = await res.json();
          if (!out.success) throw new Error(out.message);
          const first = String(new FormData(form).get("name") || "").trim().split(/\s+/)[0];
          const done = document.createElement("div");
          done.className = "ct-done"; done.tabIndex = -1; done.setAttribute("role", "status");
          const h = document.createElement("h2"); h.textContent = first ? `Thank you, ${first}. Your brief is with us.` : "Thank you. Your brief is with us.";
          const p = document.createElement("p"); p.textContent = "We reply to every enquiry within one working day.";
          const a = document.createElement("a"); a.href = "/visuals/"; a.className = "ax-link"; a.textContent = "See our work while you wait";
          done.append(h, p, a);
          form.replaceWith(done); done.focus();
        } catch (err) {
          msg.textContent = (err as Error)?.message && !/JSON|fetch|token/i.test((err as Error).message) ? (err as Error).message : "We could not send your brief. Please try again, or email info@axys3d.com.";
          btn.disabled = false; btn.textContent = "Send brief";
        }
      });
    </script>
  </body>
</html>

<style is:global>
  .ct { padding-bottom: var(--ax-section); }
  .ct h1 { font-size: clamp(48px, 6vw, 100px); }
  /* two columns on wide screens: the promise on the left stays in view while the form on the right is filled in */
  .ct .ct-grid { display: grid; grid-template-columns: minmax(0, 0.82fr) minmax(0, 1.18fr); gap: clamp(32px, 5vw, 80px); align-items: start; }
  .ct-copy { position: sticky; top: 112px; display: flex; flex-direction: column; align-items: flex-start; }
  .ct-next { list-style: none; margin: clamp(26px, 3vw, 40px) 0 0; padding: 0; display: grid; gap: 14px; }
  .ct-next li { display: flex; align-items: center; gap: 16px; font-size: 17px; font-weight: 500; line-height: 1.4; color: var(--ax-text); }
  .ct-next b { flex: none; width: 26px; font-family: var(--ax-display); font-size: 44px; font-weight: 800; line-height: 0.8; color: var(--ax-accent); }
  .ct .ct-points { margin: clamp(22px, 2.6vw, 34px) 0 0; gap: 10px; }
  .ct-points li { font-size: 16px; }
  .ct-nda { grid-column: 1 / -1; display: flex; align-items: center; gap: 12px; min-height: 44px; font-size: 15.5px; font-weight: 500; color: var(--ax-text); cursor: pointer; }
  .ct-nda input { flex: none; width: 22px; height: 22px; accent-color: var(--ax-ink); }
  .ct-mail { margin: clamp(14px, 1.8vw, 22px) 0 0; font-size: 15.5px; color: var(--ax-text-2); }
  .ct-mail a { color: var(--ax-text); font-weight: 600; text-decoration: underline; text-decoration-color: var(--ax-accent); text-decoration-thickness: 2px; text-underline-offset: 4px; display: inline-flex; align-items: center; min-height: 44px; }
  .ct .ct-form { width: 100%; padding: clamp(20px, 3vw, 40px); border-radius: var(--ax-r-card); background: var(--ax-surface); }
  .ct-done { width: 100%; padding: clamp(28px, 4vw, 48px); border-radius: var(--ax-r-card); background: var(--ax-surface); box-shadow: var(--ax-shadow); outline: none; }
  .ct-done h2 { margin: 0 0 12px; font-size: clamp(36px, 4vw, 60px); }
  .ct-done p { margin: 0 0 12px; font-size: 17px; color: var(--ax-text-2); }
  @media (max-width: 900px) {
    .ct.pg-hero { padding-top: 104px; }
    /* on phones the form comes first; the reassurance follows it instead of disappearing */
    .ct .ct-grid { display: flex; flex-direction: column; align-items: stretch; gap: 24px; }
    .ct-copy { display: contents; }
    .ct-copy h1 { order: 1; } .ct-copy .ax-lead { order: 2; margin-top: 0; }
    .ct .ct-form, .ct-done { order: 3; }
    .ct-next { order: 4; margin-top: 8px; } .ct-points { order: 5; margin-top: 0; } .ct-mail { order: 6; margin-top: 0; }
  }
</style>
